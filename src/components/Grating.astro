---
// Animated "transient grating": two crossed beams write an interference pattern
// that ripples like the surface acoustic wave it launches. Pure canvas, no deps.
---
<canvas class="grating" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.grating');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const W = 220, H = 140;
    canvas.width = W; canvas.height = H;
    const img = ctx.createImageData(W, H);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let c1 = [124, 92, 255], c2 = [6, 182, 212], dark = true;
    const readTheme = () => {
      dark = document.documentElement.dataset.theme === 'dark';
      c1 = dark ? [155, 135, 255] : [91, 61, 245];
      c2 = dark ? [34, 211, 238] : [8, 145, 178];
    };
    readTheme();
    window.addEventListener('themechange', readTheme);

    let mx = 0.62, my = 0.48;
    canvas.parentElement?.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      mx = 0.62 + ((e.clientX - r.left) / r.width - 0.5) * 0.12;
      my = 0.48 + ((e.clientY - r.top) / r.height - 0.5) * 0.12;
    });

    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(canvas);

    const draw = (t: number) => {
      const s = t / 1000;
      const d = img.data;
      const cx = mx * W, cy = my * H;
      const k = 0.62;                          // grating wave vector
      const tilt = 0.18;
      const breathe = 0.72 + 0.28 * Math.cos(s * 1.6);
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const dx = x - cx, dy = (y - cy) * 1.25;
          const env = Math.exp(-(dx * dx + dy * dy) / (2 * 46 * 46));
          const u = x + tilt * y + 2.2 * Math.sin(y * 0.07 + s * 0.9);
          const fr = 0.5 + 0.5 * Math.cos(k * u - s * 2.4);
          const I = env * (0.25 + 0.75 * fr * fr) * breathe;
          const m = Math.min(1, Math.max(0, x / W + 0.25 * Math.sin(s * 0.3)));
          const i = (y * W + x) * 4;
          d[i]     = c1[0] + (c2[0] - c1[0]) * m;
          d[i + 1] = c1[1] + (c2[1] - c1[1]) * m;
          d[i + 2] = c1[2] + (c2[2] - c1[2]) * m;
          d[i + 3] = Math.min(255, I * (dark ? 300 : 230));
        }
      }
      ctx.putImageData(img, 0, 0);
    };

    const loop = (t: number) => {
      if (visible) draw(t);
      requestAnimationFrame(loop);
    };
    if (reduce) draw(0); else requestAnimationFrame(loop);
  }
</script>

<style>
  .grating {
    position: absolute; inset: 0; width: 100%; height: 100%;
    image-rendering: auto; filter: blur(0.4px);
    mask-image: radial-gradient(ellipse 70% 80% at 62% 48%, #000 35%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 62% 48%, #000 35%, transparent 75%);
    pointer-events: none;
  }
</style>
