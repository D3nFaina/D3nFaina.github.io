---
// Home-page landing: the site's sections as balls bouncing around Den's winged portrait
// rising out of a "Dr D. Fainozzi" can. Physics runs in the script below; the can is plain SVG.
import '@fontsource/lobster/400.css';
import Icon from './Icon.astro';
import { profile, stats } from '../data/profile';

const balls = [
  { href: '/research', label: 'Research', s: 1, c: ['#d9ccff', '#8b6cf0'] },
  { href: '/publications', label: 'Publications', s: 0.96, c: ['#c6f1ff', '#3fb4e0'] },
  { href: '/projects', label: 'Projects', s: 0.86, c: ['#ffe7b8', '#f0a83c'] },
  { href: '/cv', label: 'CV', s: 0.7, c: ['#ffd0c4', '#ef6f55'] },
  { href: '/travels', label: 'Travels', s: 0.82, c: ['#cff5d6', '#4cbc6d'] },
  { href: '/interests', label: 'Interests', s: 0.78, c: ['#ffd3ec', '#e866a8'] },
  { href: '/notes', label: 'Notes', s: 0.62, c: ['#e4e7f0', '#8f97ad'] },
];

// The badge counts papers; strip the "+" for the big number.
const papers = stats[0]?.value ?? '';
const papersN = papers.replace(/\D/g, '');

// Condensation drops, seeded so the build is stable.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const drops = Array.from({ length: 70 }, () => ({
  x: 215 + rnd() * 375, y: 500 + rnd() * 740, r: 1.2 + rnd() * 3.4,
}));
const cx = 402;
---
<section class="stage" aria-label="Home">
  <div class="space" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <figure class="figure" aria-label={`${profile.title} with painted wings, rising out of a soda can`}>
    <svg class="can" viewBox="0 0 480 845" role="img" aria-hidden="true">
      <defs>
        <radialGradient id="fade" cx="245" cy="250" r="238" gradientUnits="userSpaceOnUse">
          <stop offset=".42" stop-color="#fff" />
          <stop offset=".62" stop-color="#fff" stop-opacity=".8" />
          <stop offset=".82" stop-color="#fff" stop-opacity=".3" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </radialGradient>
        <mask id="photo-fade" maskUnits="userSpaceOnUse" x="0" y="0" width="480" height="480">
          <rect width="480" height="480" fill="url(#fade)" />
        </mask>
        <linearGradient id="body" x1="0" x2="1">
          <stop offset="0" stop-color="#2c050c" />
          <stop offset=".14" stop-color="#6b1020" />
          <stop offset=".34" stop-color="#9c1f34" />
          <stop offset=".43" stop-color="#c94a62" />
          <stop offset=".5" stop-color="#a42339" />
          <stop offset=".72" stop-color="#7a1426" />
          <stop offset="1" stop-color="#2a050b" />
        </linearGradient>
        <linearGradient id="metal" x1="0" x2="1">
          <stop offset="0" stop-color="#6d7178" />
          <stop offset=".3" stop-color="#e9ecef" />
          <stop offset=".5" stop-color="#b9bec4" />
          <stop offset=".7" stop-color="#f5f6f7" />
          <stop offset="1" stop-color="#5f636a" />
        </linearGradient>
        <radialGradient id="hole" cx=".5" cy=".4" r=".6">
          <stop offset="0" stop-color="#15030a" />
          <stop offset="1" stop-color="#3a0912" />
        </radialGradient>
        <path id="badge-arc" d={`M ${cx - 117} 1010 a 57 57 0 1 1 114 0 a 57 57 0 1 1 -114 0`} />
      </defs>

      <!-- the whole profile picture, fading out at the edges -->
      <image href="/home/den-wings.jpg" x="0" y="0" width="480" height="480" mask="url(#photo-fade)" preserveAspectRatio="xMidYMid slice" />

      <g transform="translate(74 203.2) scale(.4975)">
        <!-- back of the lid and the opening -->
        <ellipse cx={cx} cy="476" rx="178" ry="24" fill="url(#metal)" />
        <ellipse cx={cx} cy="478" rx="150" ry="17" fill="url(#hole)" />
      </g>
      <!-- his torso again, so it sits inside the opening -->
      <image href="/home/den-torso.png" x="185" y="370" width="170" height="110" />

      <g transform="translate(74 203.2) scale(.4975)">
        <path
          d={`M ${cx - 178} 476 C ${cx - 180} 492 ${cx - 201} 500 ${cx - 201} 525 L ${cx - 201} 1222 C ${cx - 201} 1240 ${cx - 184} 1250 ${cx - 182} 1262 A 182 22 0 0 0 ${cx + 182} 1262 C ${cx + 184} 1250 ${cx + 201} 1240 ${cx + 201} 1222 L ${cx + 201} 525 C ${cx + 201} 500 ${cx + 180} 492 ${cx + 178} 476 A 178 24 0 0 1 ${cx - 178} 476 Z`}
          fill="url(#body)" />
        <path d={`M ${cx - 178} 476 A 178 24 0 0 0 ${cx + 178} 476 C ${cx + 182} 492 ${cx + 196} 498 ${cx + 199} 512 A 199 26 0 0 1 ${cx - 199} 512 C ${cx - 196} 498 ${cx - 182} 492 ${cx - 178} 476 Z`} fill="url(#metal)" opacity=".95" />
        <path d={`M ${cx - 201} 1222 C ${cx - 201} 1240 ${cx - 184} 1250 ${cx - 182} 1262 A 182 22 0 0 0 ${cx + 182} 1262 C ${cx + 184} 1250 ${cx + 201} 1240 ${cx + 201} 1222 A 201 24 0 0 1 ${cx - 201} 1222 Z`} fill="url(#metal)" />

        <!-- logo: one script for "Dr" and "D. Fainozzi", laid out like the original -->
        <g class="logo" fill="#fff">
          <ellipse cx={cx + 4} cy="790" rx="194" ry="112" fill="none" stroke="#fff" stroke-width="6" transform={`rotate(-8 ${cx} 790)`} />
          <text x={cx + 84} y="772" text-anchor="middle" font-family="Lobster, cursive" font-size="104">Dr</text>
          <text x={cx - 2} y="852" text-anchor="middle" font-family="Lobster, cursive" font-size="74" textLength="300" lengthAdjust="spacingAndGlyphs">D. Fainozzi</text>
          <text x={cx + 118} y="932" text-anchor="middle" font-family="Inter Variable, sans-serif" font-weight="600" font-size="26">Est.2020</text>
          <circle cx={cx - 60} cy="1010" r="70" fill="none" stroke="#fff" stroke-width="4" />
          <circle cx={cx - 60} cy="1010" r="44" fill="none" stroke="#fff" stroke-width="3" />
          <text x={cx - 60} y="1030" text-anchor="middle" font-family="Lobster, cursive" font-size="54">{papersN}</text>
          <text font-family="Inter Variable, sans-serif" font-weight="700" font-size="12.5" letter-spacing="1.6">
            <textPath href="#badge-arc" startOffset="0">AUTHENTIC BLEND OF {papers} PAPERS ·</textPath>
          </text>
        </g>

        <g fill="#fff">
          {drops.map((d) => <ellipse cx={d.x} cy={d.y} rx={d.r * 0.8} ry={d.r} opacity={0.12 + (d.r / 4.6) * 0.22} />)}
        </g>
        <path d={`M ${cx - 60} 520 L ${cx - 30} 520 L ${cx - 30} 1236 L ${cx - 60} 1236 Z`} fill="#fff" opacity=".08" />
      </g>
    </svg>
  </figure>

  <nav class="balls" aria-label="Sections">
    {balls.map((b) => (
      <a class="ball" href={b.href} data-s={b.s} style={`--c1:${b.c[0]};--c2:${b.c[1]}`} draggable="false">
        <span>{b.label}</span>
      </a>
    ))}
  </nav>

  <div class="caption">
    <p class="role">{profile.title} · {profile.role}</p>
    <p class="aff"><Icon name="pin" size={14} /> {profile.affiliation}</p>
    <div class="socials">
      {profile.links.github && <a href={profile.links.github}><Icon name="github" size={16} /> GitHub</a>}
      {profile.links.orcid && <a href={profile.links.orcid}><Icon name="orcid" size={16} /> ORCID</a>}
      <a href={`mailto:${profile.email}`}><Icon name="mail" size={16} /> Email</a>
      {profile.links.cringedin && <a href={profile.links.cringedin} target="_blank" rel="noopener"><Icon name="cringedin" size={16} /> CringedIn</a>}
    </div>
  </div>
  <p class="hint" aria-hidden="true">Grab a ball and throw it · click one to go there</p>
  <a class="down" href="#about" aria-label="Scroll down"><Icon name="arrow" size={18} /></a>
</section>

<script>
  type Ball = { el: HTMLElement; x: number; y: number; vx: number; vy: number; r: number; m: number; held: boolean };

  const stage = document.querySelector<HTMLElement>('.stage')!;
  const figure = stage.querySelector<HTMLElement>('.figure')!;
  const caption = stage.querySelector<HTMLElement>('.caption')!;
  let BOT = 0; // keep clear of the caption on phones
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let W = 0, H = 0;
  const balls: Ball[] = [...stage.querySelectorAll<HTMLElement>('.ball')].map((el) => ({
    el, x: 0, y: 0, vx: 0, vy: 0, r: 0, m: 1, held: false,
  }));

  // The can as an obstacle: a rectangle in stage coordinates.
  let ob = { x0: 0, y0: 0, x1: 0, y1: 0 };
  const measure = () => {
    const s = stage.getBoundingClientRect();
    W = s.width; H = s.height;
    const f = figure.getBoundingClientRect();
    // The middle of the portrait (Den and the wings' inner edge) and the can.
    ob = { x0: f.left - s.left + f.width * 0.2, x1: f.left - s.left + f.width * 0.8, y0: f.top - s.top + f.height * 0.08, y1: f.top - s.top + f.height * 0.99 };
    BOT = W < 760 ? caption.offsetHeight : 0;
    const base = Math.min(W, H) * (W < 640 ? 0.12 : 0.105);
    for (const b of balls) {
      b.r = Math.max(34, base * Number(b.el.dataset.s));
      b.m = b.r * b.r;
      b.el.style.width = b.el.style.height = `${b.r * 2}px`;
      b.el.style.fontSize = `${Math.max(12, b.r * 0.27)}px`;
    }
  };

  const place = () => {
    // Spread the balls around the can without overlaps.
    const out: Ball[] = [];
    for (const b of balls) {
      for (let tries = 0; tries < 400; tries++) {
        b.x = b.r + Math.random() * (W - 2 * b.r);
        b.y = b.r + 70 + Math.random() * (H - BOT - 2 * b.r - 70);
        const hitsCan = b.x + b.r > ob.x0 - 10 && b.x - b.r < ob.x1 + 10 && b.y + b.r > ob.y0 && b.y - b.r < ob.y1;
        if (!hitsCan && out.every((o) => Math.hypot(o.x - b.x, o.y - b.y) > o.r + b.r + 8)) break;
      }
      const a = Math.random() * Math.PI * 2, v = 40 + Math.random() * 50;
      b.vx = Math.cos(a) * v; b.vy = Math.sin(a) * v;
      out.push(b);
    }
  };

  const draw = () => {
    for (const b of balls) b.el.style.transform = `translate(${b.x - b.r}px, ${b.y - b.r}px)`;
  };

  measure(); place(); draw();
  stage.classList.add('ready');

  const TOP = 64; // keep clear of the header
  const step = (dt: number) => {
    for (const b of balls) {
      if (b.held) continue;
      b.x += b.vx * dt; b.y += b.vy * dt;
      // Gentle drag on fast throws, a floor on slow drifts so nothing stops.
      const sp = Math.hypot(b.vx, b.vy);
      if (sp > 120) { const k = 1 - Math.min(0.9, dt * 0.9); b.vx *= k; b.vy *= k; }
      else if (sp < 30) { const k = 1 + dt * 0.8; b.vx = (b.vx || 1) * k; b.vy = (b.vy || 1) * k; }
      if (b.x < b.r) { b.x = b.r; b.vx = Math.abs(b.vx); }
      if (b.x > W - b.r) { b.x = W - b.r; b.vx = -Math.abs(b.vx); }
      if (b.y < b.r + TOP) { b.y = b.r + TOP; b.vy = Math.abs(b.vy); }
      if (b.y > H - BOT - b.r) { b.y = H - BOT - b.r; b.vy = -Math.abs(b.vy); }
      // Bounce off the can (closest point on its rectangle).
      const px = Math.max(ob.x0, Math.min(b.x, ob.x1)), py = Math.max(ob.y0, Math.min(b.y, ob.y1));
      let dx = b.x - px, dy = b.y - py, d = Math.hypot(dx, dy);
      if (d < b.r) {
        if (d === 0) { dx = b.x < (ob.x0 + ob.x1) / 2 ? -1 : 1; dy = 0; d = 1; }
        const nx = dx / d, ny = dy / d;
        b.x = px + nx * b.r; b.y = py + ny * b.r;
        const vn = b.vx * nx + b.vy * ny;
        if (vn < 0) { b.vx -= 2 * vn * nx; b.vy -= 2 * vn * ny; }
      }
    }
    // Ball-ball elastic collisions.
    for (let i = 0; i < balls.length; i++) for (let j = i + 1; j < balls.length; j++) {
      const a = balls[i], b = balls[j];
      const dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy), min = a.r + b.r;
      if (d >= min || d === 0) continue;
      const nx = dx / d, ny = dy / d;
      const ma = a.held ? 1e9 : a.m, mb = b.held ? 1e9 : b.m;
      const push = (min - d);
      a.x -= nx * push * (mb / (ma + mb)); a.y -= ny * push * (mb / (ma + mb));
      b.x += nx * push * (ma / (ma + mb)); b.y += ny * push * (ma / (ma + mb));
      const rel = (b.vx - a.vx) * nx + (b.vy - a.vy) * ny;
      if (rel > 0) continue;
      const imp = (-2 * rel) / (1 / ma + 1 / mb);
      if (!a.held) { a.vx -= (imp / ma) * nx; a.vy -= (imp / ma) * ny; }
      if (!b.held) { b.vx += (imp / mb) * nx; b.vy += (imp / mb) * ny; }
    }
    // Collisions can push a ball through a wall; put it back.
    for (const b of balls) {
      b.x = Math.max(b.r, Math.min(W - b.r, b.x));
      b.y = Math.max(b.r + TOP, Math.min(H - BOT - b.r, b.y));
    }
  };

  let last = performance.now(), visible = true;
  const loop = (t: number) => {
    const dt = Math.min(0.033, (t - last) / 1000); last = t;
    if (visible) { step(dt); draw(); }
    requestAnimationFrame(loop);
  };
  if (!still) requestAnimationFrame(loop);
  new IntersectionObserver(([e]) => { visible = e.isIntersecting; last = performance.now(); }).observe(stage);
  // Dark header while it sits over the stage.
  new IntersectionObserver(([e]) => document.body.classList.toggle('on-stage', e.isIntersecting), { rootMargin: '-64px 0px 0px 0px', threshold: 0 }).observe(stage);

  addEventListener('resize', () => {
    const ow = W, oh = H;
    measure();
    for (const b of balls) { b.x *= W / ow; b.y *= H / oh; }
    if (still) draw();
  });

  // Drag and throw. A press that barely moves is a click and follows the link.
  for (const b of balls) {
    let sx = 0, sy = 0, moved = false, hist: { x: number; y: number; t: number }[] = [];
    b.el.addEventListener('pointerdown', (e) => {
      if (still) return;
      b.el.setPointerCapture(e.pointerId);
      b.held = true; moved = false; sx = e.clientX; sy = e.clientY; hist = [];
      b.el.classList.add('held');
    });
    b.el.addEventListener('pointermove', (e) => {
      if (!b.held) return;
      if (Math.hypot(e.clientX - sx, e.clientY - sy) > 6) moved = true;
      const s = stage.getBoundingClientRect();
      b.x = Math.max(b.r, Math.min(W - b.r, e.clientX - s.left));
      b.y = Math.max(b.r + TOP, Math.min(H - BOT - b.r, e.clientY - s.top));
      hist.push({ x: b.x, y: b.y, t: performance.now() });
      if (hist.length > 6) hist.shift();
      if (still) draw();
    });
    const release = () => {
      if (!b.held) return;
      b.held = false; b.el.classList.remove('held');
      if (hist.length > 1) {
        const a = hist[0], z = hist[hist.length - 1], dt = Math.max(0.016, (z.t - a.t) / 1000);
        b.vx = Math.max(-1600, Math.min(1600, (z.x - a.x) / dt));
        b.vy = Math.max(-1600, Math.min(1600, (z.y - a.y) / dt));
      }
    };
    b.el.addEventListener('pointerup', release);
    b.el.addEventListener('pointercancel', release);
    b.el.addEventListener('click', (e) => { if (moved) e.preventDefault(); });
  }
</script>

<style>
  .stage {
    position: relative; overflow: hidden; margin-top: -65px;
    height: 100svh; min-height: 600px; max-height: 1100px;
    background: #26262b; color: #f3f4fb; isolation: isolate;
    touch-action: pan-y;
  }
  :global(body.on-stage .site-header) { background: rgba(30, 30, 36, 0.5); border-bottom-color: rgba(255, 255, 255, 0.08); }
  :global(body.on-stage .site-header .who) { color: #f3f4fb; }
  @media (min-width: 981px) {
    :global(body.on-stage .site-header .nav a) { color: rgba(243, 244, 251, 0.82); }
    :global(body.on-stage .site-header .nav a:hover) { color: #fff; background: rgba(255, 255, 255, 0.08); }
  }
  .space { position: absolute; inset: 0; z-index: -1; overflow: hidden; background: #26262b; }
  /* Four soft colour fields in the wings' colours, drifting and shifting hue so the
     background turns a different colour in every direction around the portrait. */
  .space i { position: absolute; width: 75vmax; height: 75vmax; border-radius: 50%; filter: blur(70px); opacity: .75; mix-blend-mode: screen; animation: drift 26s ease-in-out infinite alternate, hue 40s linear infinite; }
  .space i:nth-child(1) { left: -25vmax; top: -30vmax; background: radial-gradient(circle, #e2367f 0%, transparent 65%); }
  .space i:nth-child(2) { right: -25vmax; top: -25vmax; background: radial-gradient(circle, #3d5ce0 0%, transparent 65%); animation-delay: -7s, -10s; }
  .space i:nth-child(3) { left: -20vmax; bottom: -35vmax; background: radial-gradient(circle, #2cc4e6 0%, transparent 65%); animation-delay: -13s, -20s; }
  .space i:nth-child(4) { right: -25vmax; bottom: -30vmax; background: radial-gradient(circle, #8f4ce6 0%, transparent 65%); animation-delay: -19s, -30s; }
  @keyframes drift { to { translate: 8vmax 6vmax; scale: 1.15; } }
  @keyframes hue { to { filter: blur(70px) hue-rotate(360deg); } }

  .figure {
    position: absolute; left: 50%; top: 53%; margin: 0;
    height: min(86%, 980px); aspect-ratio: 480 / 845;
    transform: translate(-50%, -50%);
    animation: float 8s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes float { 50% { transform: translate(-50%, calc(-50% - 12px)); } }
  .can { width: 100%; height: 100%; overflow: visible; display: block; filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.45)); }

  .balls { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .ball {
    position: absolute; left: 0; top: 0; border-radius: 50%; pointer-events: auto;
    display: grid; place-items: center; text-align: center; user-select: none; -webkit-user-select: none;
    color: #14162a; font-weight: 650; letter-spacing: -0.01em; cursor: grab; touch-action: none;
    background: radial-gradient(circle at 32% 28%, #fff 0%, var(--c1) 22%, var(--c2) 78%, color-mix(in srgb, var(--c2) 60%, #000) 100%);
    box-shadow: inset -8px -12px 24px rgba(0, 0, 0, 0.22), 0 0 32px -4px color-mix(in srgb, var(--c2) 70%, transparent);
    opacity: 0; transition: opacity .6s ease, scale .25s ease, box-shadow .25s ease;
    will-change: transform;
  }
  .stage.ready .ball { opacity: 1; }
  .ball span { padding: 0 8%; line-height: 1.05; pointer-events: none; }
  .ball:hover { scale: 1.08; box-shadow: inset -8px -12px 24px rgba(0, 0, 0, 0.2), 0 0 46px 2px color-mix(in srgb, var(--c2) 85%, transparent); }
  .ball:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  .ball.held { cursor: grabbing; scale: 1.1; }

  .caption { position: absolute; left: 0; bottom: 0; z-index: 3; padding: 0 24px 22px; max-width: 640px; pointer-events: none; }
  .caption > * { pointer-events: auto; }
  .role { margin: 0; font-size: 12.5px; font-weight: 650; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(243, 244, 251, 0.85); }
  .aff { display: flex; align-items: center; gap: 6px; margin: 6px 0 0; font-size: 13.5px; color: rgba(243, 244, 251, 0.6); }
  .socials { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 10px; }
  .socials a { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; color: rgba(243, 244, 251, 0.75); }
  .socials a:hover { color: #fff; }
  .hint { position: absolute; right: 24px; bottom: 22px; z-index: 3; margin: 0; font-family: 'Caveat', cursive; font-size: 21px; color: rgba(243, 244, 251, 0.6); }
  .down { position: absolute; left: 50%; bottom: 14px; z-index: 3; translate: -50% 0; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.25); color: #fff; rotate: 90deg; animation: nudge 2.4s ease-in-out infinite; }
  @keyframes nudge { 50% { translate: -50% 6px; } }

  @media (max-width: 760px) {
    .figure { height: min(62%, 560px); top: 50%; }
    .hint { display: none; }
    .down { display: none; }
    .caption { padding: 0 16px 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .figure, .space i, .down { animation: none; }
  }
</style>
