---
// Home-page landing: the site's sections as balls bouncing around Den's winged portrait
// rising out of a "Dr D. Fainozzi" can (Den's own image, public/home/den-can-wall-v2.*). Physics runs below.
import Icon from './Icon.astro';
import { profile, stats } from '../data/profile';

const balls = [
  // fx: the little piece of physics each ball carries (see FX in the script).
  { href: '/research', label: 'Research', s: 1, c: ['#d9ccff', '#8b6cf0'], fx: 'grating' },
  { href: '/publications', label: 'Publications', s: 0.96, c: ['#c6f1ff', '#3fb4e0'], fx: 'earth' },
  { href: '/projects', label: 'Projects', s: 0.86, c: ['#fff1a8', '#f5a623'], fx: 'sun' },
  { href: '/cv', label: 'CV', s: 0.7, c: ['#ffd0c4', '#ef6f55'], fx: 'atom' },
  { href: '/travels', label: 'Travels', s: 0.82, c: ['#cff5d6', '#4cbc6d'], fx: 'ufo' },
  { href: '/interests', label: 'Interests', s: 0.78, c: ['#ffd3ec', '#e866a8'], fx: 'fizz' },
  { href: '/notes', label: 'Notes', s: 0.62, c: ['#f1e6cf', '#c4a473'], fx: 'saturn' },
];

---
<section class="stage" aria-label="Home">
  <picture class="photo">
    <source srcset="/home/den-can-wall-v2.webp" type="image/webp" />
    <img src="/home/den-can-wall-v2.jpg" width="3712" height="2716" alt={`${profile.title} in front of painted angel wings, rising out of a Dr D. Fainozzi soda can`} />
  </picture>

  <nav class="balls" aria-label="Sections">
    {balls.map((b) => (
      <a class={`ball fx-${b.fx}`} href={b.href} data-s={b.s} data-fx={b.fx} style={`--c1:${b.c[0]};--c2:${b.c[1]}`} draggable="false">
        <i class="face">
          {b.fx === 'grating' && <i class="fringes" />}
          {b.fx === 'fizz' && [0, 1, 2, 3, 4, 5, 6].map((k) => <i class="bub" style={`--k:${k}`} />)}
        </i>
        {b.fx === 'saturn' && <><i class="ring back" /><i class="ring front" /></>}
        <span>{b.label}</span>
      </a>
    ))}
  </nav>

  <div class="caption">
    <p class="role">{profile.title} · {profile.role}</p>
    <p class="aff"><Icon name="pin" size={14} /> {profile.affiliation}</p>
    <div class="socials">
      {profile.links.github && <a href={profile.links.github}><Icon name="github" size={16} /> GitHub</a>}
      {profile.links.orcid && <a href={profile.links.orcid}><Icon name="orcid" size={16} /> ORCID</a>}
      <a href={`mailto:${profile.email}`}><Icon name="mail" size={16} /> Email</a>
      {profile.links.cringedin && <a href={profile.links.cringedin} target="_blank" rel="noopener"><Icon name="cringedin" size={16} /> CringedIn</a>}
    </div>
  </div>
  <p class="hint" aria-hidden="true">Grab a ball and throw it · click one to go there</p>
  <a class="down" href="#about" aria-label="Scroll down"><Icon name="arrow" size={18} /></a>
</section>

<script>
  type Ball = { el: HTMLElement; x: number; y: number; vx: number; vy: number; r: number; m: number; held: boolean };

  const stage = document.querySelector<HTMLElement>('.stage')!;
  const caption = stage.querySelector<HTMLElement>('.caption')!;
  let BOT = 0; // keep clear of the caption on phones
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let W = 0, H = 0;
  const balls: Ball[] = [...stage.querySelectorAll<HTMLElement>('.ball')].map((el) => ({
    el, x: 0, y: 0, vx: 0, vy: 0, r: 0, m: 1, held: false,
  }));

  // The can as an obstacle: a rectangle in stage coordinates.
  let ob = { x0: 0, y0: 0, x1: 0, y1: 0 };
  const IW = 3712, IH = 2716, PX = 0.47, PY = 1; // photo size and object-position
  const DEN = { x0: 1440, x1: 2090, y0: 1380, y1: 2716 }; // Den and the can, in photo pixels
  const measure = () => {
    const s = stage.getBoundingClientRect();
    W = s.width; H = s.height;
    // Where Den and the can land on screen: the photo is object-fit: cover, positioned
    // at PX/PY, so map their box from photo pixels to stage pixels.
    const k = Math.max(W / IW, H / IH), ox = (W - IW * k) * PX, oy = (H - IH * k) * PY;
    ob = { x0: ox + DEN.x0 * k, x1: ox + DEN.x1 * k, y0: oy + DEN.y0 * k, y1: oy + DEN.y1 * k };
    BOT = W < 760 ? caption.offsetHeight : 0;
    const base = Math.min(W, H) * (W < 640 ? 0.12 : 0.105);
    for (const b of balls) {
      b.r = Math.max(34, base * Number(b.el.dataset.s));
      b.m = b.r * b.r;
      b.el.style.width = b.el.style.height = `${b.r * 2}px`;
      b.el.style.fontSize = `${Math.max(17, b.r * 0.4)}px`;
    }
  };

  const place = () => {
    // Spread the balls around the can without overlaps.
    const out: Ball[] = [];
    for (const b of balls) {
      for (let tries = 0; tries < 400; tries++) {
        b.x = b.r + Math.random() * (W - 2 * b.r);
        b.y = b.r + 70 + Math.random() * (H - BOT - 2 * b.r - 70);
        const hitsCan = b.x + b.r > ob.x0 - 10 && b.x - b.r < ob.x1 + 10 && b.y + b.r > ob.y0 && b.y - b.r < ob.y1;
        if (!hitsCan && out.every((o) => Math.hypot(o.x - b.x, o.y - b.y) > o.r + b.r + 8)) break;
      }
      const a = Math.random() * Math.PI * 2, v = 40 + Math.random() * 50;
      b.vx = Math.cos(a) * v; b.vy = Math.sin(a) * v;
      out.push(b);
    }
  };

  // Satellites: bodies on tilted elliptical orbits around a ball. a = semi-major axis and
  // size = body radius, both in ball radii; e = minor/major ratio (the orbit's inclination
  // seen from here); T = period in seconds. Bodies on the far half go behind the ball.
  type Sat = { a: number; e: number; tilt: number; size: number; color: string; T: number; ph?: number; ring?: boolean; glow?: boolean };
  const FX: Record<string, Sat[]> = {
    sun: [
      { a: 1.32, e: 0.3, tilt: -10, size: 0.075, color: '#b9b2a8', T: 4, ring: true },
      { a: 1.62, e: 0.3, tilt: -10, size: 0.12, color: '#5aa2ff', T: 7, ph: 2, ring: true },
      { a: 1.98, e: 0.3, tilt: -10, size: 0.1, color: '#ff7a4a', T: 11, ph: 4.2, ring: true },
    ],
    earth: [{ a: 1.72, e: 0.28, tilt: 16, size: 0.2, color: '#d9dce3', T: 10, ring: true }],
    atom: [0, 60, 120].map((tilt, i) => ({ a: 1.42, e: 0.3, tilt, size: 0.09, color: '#7df9ff', T: 1.5 + i * 0.35, ph: i * 2.1, ring: true, glow: true })),
  };
  const sats: { b: Ball; s: Sat; el: HTMLElement }[] = [];
  const rings: { b: Ball; s: Sat; el: HTMLElement }[] = [];
  for (const b of balls) for (const s of FX[b.el.dataset.fx || ''] ?? []) {
    if (s.ring) {
      const el = document.createElement('i'); el.className = 'orbit'; b.el.prepend(el); rings.push({ b, s, el });
    }
    const el = document.createElement('i');
    el.className = s.glow ? 'sat glow' : 'sat';
    el.style.background = s.color;
    b.el.append(el); sats.push({ b, s, el });
  }
  // Travels: Rick's saucer, a three.js model on its own canvas around the ball. An invisible
  // sphere the size of the ball hides the far half of the orbit.
  const UFO = { a: 1.45, size: 0.44 };
  const ufoBall = balls.find((b) => b.el.dataset.fx === 'ufo');
  let ufo: { resize(): void; start(): void; stop(): void } | null = null, ufoCanvas: HTMLCanvasElement | null = null;
  const ufoGeom = () => {
    const r = ufoBall!.r, w = Math.ceil(2 * r * (UFO.a + UFO.size * 1.6));
    return { w, h: w, cx: w / 2, cy: w / 2, R: r };
  };
  const syncUfo = async () => {
    if (!ufoBall) return;
    if (!on()) { ufo?.stop(); return; }
    if (!ufoCanvas) {
      ufoCanvas = document.createElement('canvas'); ufoCanvas.className = 'ufo'; ufoCanvas.setAttribute('aria-hidden', 'true');
      ufoBall.el.append(ufoCanvas);
      const { mountSaucer } = await import('../lib/saucer');
      ufo = mountSaucer(ufoCanvas, ufoGeom, { a: UFO.a, incl: 70, tilt: -16, T: 9, size: UFO.size });
    }
    ufo?.resize(); ufo?.start();
  };
  const sizeRings = () => {
    for (const { b, s, el } of rings) {
      const w = 2 * s.a * b.r, h = w * s.e;
      el.style.width = `${w}px`; el.style.height = `${h}px`;
      el.style.transform = `translate(-50%, -50%) rotate(${s.tilt}deg)`;
    }
  };

  const draw = (t = 0) => {
    for (const b of balls) b.el.style.transform = `translate(${b.x - b.r}px, ${b.y - b.r}px)`;
    for (const { b, s, el } of sats) {
      const th = (t / 1000) * (2 * Math.PI / s.T) + (s.ph ?? 0);
      const A = s.a * b.r, B = A * s.e, c = Math.cos(s.tilt * Math.PI / 180), sn = Math.sin(s.tilt * Math.PI / 180);
      const ex = A * Math.cos(th), ey = B * Math.sin(th);
      const x = ex * c - ey * sn, y = ex * sn + ey * c;
      const near = Math.sin(th) > 0; // lower half of the ellipse is the near side
      const d = 2 * s.size * b.r, k = 1 + 0.18 * Math.sin(th);
      el.style.width = el.style.height = `${d}px`;
      el.style.transform = `translate(${x - d / 2}px, ${y - d / 2}px) scale(${k})`;
      el.style.zIndex = near ? '2' : '-1';
    }
  };

  // The stage only exists in "cringe" mode (html[data-cringe=on], set by the switch on the
  // home page), so the physics starts the first time that mode is shown.
  const on = () => document.documentElement.dataset.cringe === 'on';
  let started = false;
  const activate = () => {
    if (!on()) return;
    measure(); sizeRings();
    if (!started) { started = true; place(); last = performance.now(); if (!still) requestAnimationFrame(loop); }
    draw(performance.now());
    syncUfo();
    stage.classList.add('ready');
  };

  const TOP = 64; // keep clear of the header
  let last = performance.now();
  const step = (dt: number) => {
    for (const b of balls) {
      if (b.held) continue;
      b.x += b.vx * dt; b.y += b.vy * dt;
      // Gentle drag on fast throws, a floor on slow drifts so nothing stops.
      const sp = Math.hypot(b.vx, b.vy);
      if (sp > 120) { const k = 1 - Math.min(0.9, dt * 0.9); b.vx *= k; b.vy *= k; }
      else if (sp < 30) { const k = 1 + dt * 0.8; b.vx = (b.vx || 1) * k; b.vy = (b.vy || 1) * k; }
      if (b.x < b.r) { b.x = b.r; b.vx = Math.abs(b.vx); }
      if (b.x > W - b.r) { b.x = W - b.r; b.vx = -Math.abs(b.vx); }
      if (b.y < b.r + TOP) { b.y = b.r + TOP; b.vy = Math.abs(b.vy); }
      if (b.y > H - BOT - b.r) { b.y = H - BOT - b.r; b.vy = -Math.abs(b.vy); }
      // Bounce off the can (closest point on its rectangle).
      const px = Math.max(ob.x0, Math.min(b.x, ob.x1)), py = Math.max(ob.y0, Math.min(b.y, ob.y1));
      let dx = b.x - px, dy = b.y - py, d = Math.hypot(dx, dy);
      if (d < b.r) {
        if (d === 0) { dx = b.x < (ob.x0 + ob.x1) / 2 ? -1 : 1; dy = 0; d = 1; }
        const nx = dx / d, ny = dy / d;
        b.x = px + nx * b.r; b.y = py + ny * b.r;
        const vn = b.vx * nx + b.vy * ny;
        if (vn < 0) { b.vx -= 2 * vn * nx; b.vy -= 2 * vn * ny; }
      }
    }
    // Ball-ball elastic collisions.
    for (let i = 0; i < balls.length; i++) for (let j = i + 1; j < balls.length; j++) {
      const a = balls[i], b = balls[j];
      const dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy), min = a.r + b.r;
      if (d >= min || d === 0) continue;
      const nx = dx / d, ny = dy / d;
      const ma = a.held ? 1e9 : a.m, mb = b.held ? 1e9 : b.m;
      const push = (min - d);
      a.x -= nx * push * (mb / (ma + mb)); a.y -= ny * push * (mb / (ma + mb));
      b.x += nx * push * (ma / (ma + mb)); b.y += ny * push * (ma / (ma + mb));
      const rel = (b.vx - a.vx) * nx + (b.vy - a.vy) * ny;
      if (rel > 0) continue;
      const imp = (-2 * rel) / (1 / ma + 1 / mb);
      if (!a.held) { a.vx -= (imp / ma) * nx; a.vy -= (imp / ma) * ny; }
      if (!b.held) { b.vx += (imp / mb) * nx; b.vy += (imp / mb) * ny; }
    }
    // Collisions can push a ball through a wall; put it back.
    for (const b of balls) {
      b.x = Math.max(b.r, Math.min(W - b.r, b.x));
      b.y = Math.max(b.r + TOP, Math.min(H - BOT - b.r, b.y));
    }
  };

  let visible = true;
  const loop = (t: number) => {
    const dt = Math.min(0.033, (t - last) / 1000); last = t;
    if (visible && on()) { step(dt); draw(t); }
    requestAnimationFrame(loop);
  };
  activate();
  addEventListener('cringechange', () => { activate(); if (!on()) ufo?.stop(); });
  new IntersectionObserver(([e]) => { visible = e.isIntersecting; last = performance.now(); }).observe(stage);
  // Dark header while it sits over the stage.
  new IntersectionObserver(([e]) => document.body.classList.toggle('on-stage', e.isIntersecting), { rootMargin: '-64px 0px 0px 0px', threshold: 0 }).observe(stage);

  addEventListener('resize', () => {
    if (!started || !on()) return;
    const ow = W, oh = H;
    measure(); sizeRings(); ufo?.resize();
    for (const b of balls) { b.x *= W / ow; b.y *= H / oh; }
    if (still) draw();
  });

  // Drag and throw. A press that barely moves is a click and follows the link.
  for (const b of balls) {
    let sx = 0, sy = 0, moved = false, hist: { x: number; y: number; t: number }[] = [];
    b.el.addEventListener('pointerdown', (e) => {
      if (still) return;
      b.el.setPointerCapture(e.pointerId);
      b.held = true; moved = false; sx = e.clientX; sy = e.clientY; hist = [];
      b.el.classList.add('held');
    });
    b.el.addEventListener('pointermove', (e) => {
      if (!b.held) return;
      if (Math.hypot(e.clientX - sx, e.clientY - sy) > 6) moved = true;
      const s = stage.getBoundingClientRect();
      b.x = Math.max(b.r, Math.min(W - b.r, e.clientX - s.left));
      b.y = Math.max(b.r + TOP, Math.min(H - BOT - b.r, e.clientY - s.top));
      hist.push({ x: b.x, y: b.y, t: performance.now() });
      if (hist.length > 6) hist.shift();
      if (still) draw();
    });
    const release = () => {
      if (!b.held) return;
      b.held = false; b.el.classList.remove('held');
      if (hist.length > 1) {
        const a = hist[0], z = hist[hist.length - 1], dt = Math.max(0.016, (z.t - a.t) / 1000);
        b.vx = Math.max(-1600, Math.min(1600, (z.x - a.x) / dt));
        b.vy = Math.max(-1600, Math.min(1600, (z.y - a.y) / dt));
      }
    };
    b.el.addEventListener('pointerup', release);
    b.el.addEventListener('pointercancel', release);
    b.el.addEventListener('click', (e) => { if (moved) e.preventDefault(); });
  }
</script>

<style>
  .stage {
    position: relative; overflow: hidden; margin-top: -65px;
    height: 100svh; min-height: 600px; max-height: 1100px;
    background: #1c2129; color: #f3f4fb; isolation: isolate;
    touch-action: pan-y;
  }
  /* Classic home is the default; the stage replaces it in cringe mode, where the balls are the nav. */
  :global(html:not([data-cringe='on'])) .stage { display: none; }
  :global(html[data-cringe='on'] .site-header .nav), :global(html[data-cringe='on'] .site-header .menu-btn) { display: none; }
  :global(body.on-stage .site-header) { background: rgba(30, 30, 36, 0.5); border-bottom-color: rgba(255, 255, 255, 0.08); }
  :global(body.on-stage .site-header .who) { color: #f3f4fb; }
  @media (min-width: 981px) {
    :global(body.on-stage .site-header .nav a) { color: rgba(243, 244, 251, 0.82); }
    :global(body.on-stage .site-header .nav a:hover) { color: #fff; background: rgba(255, 255, 255, 0.08); }
  }
  .photo { position: absolute; inset: 0; z-index: -1; }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: 47% 100%; display: block; }

  .balls { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .ball {
    position: absolute; left: 0; top: 0; border-radius: 50%; pointer-events: auto;
    display: grid; place-items: center; text-align: center; user-select: none; -webkit-user-select: none;
    color: #14162a; font-family: 'Caveat', cursive; font-weight: 600; letter-spacing: 0; cursor: grab; touch-action: none;
    opacity: 0; transition: opacity .6s ease, scale .25s ease;
    will-change: transform; isolation: isolate;
  }
  /* The ball's own surface sits at z 0 so orbiting bodies can pass behind (z -1) or in front (z 2). */
  .face {
    position: absolute; inset: 0; z-index: 0; border-radius: 50%; overflow: hidden;
    background: radial-gradient(circle at 32% 28%, #fff 0%, var(--c1) 22%, var(--c2) 78%, color-mix(in srgb, var(--c2) 60%, #000) 100%);
    box-shadow: inset -8px -12px 24px rgba(0, 0, 0, 0.22), 0 0 32px -4px color-mix(in srgb, var(--c2) 70%, transparent);
    transition: box-shadow .25s ease;
  }
  .ball span { position: relative; z-index: 1; }
  /* .sat and .orbit are made by the script, so they need :global to get styled. */
  .balls :global(.sat) { position: absolute; left: 50%; top: 50%; border-radius: 50%; pointer-events: none;
    box-shadow: inset -2px -3px 5px rgba(0, 0, 0, 0.35); }
  .balls :global(.sat.glow) { box-shadow: 0 0 8px 2px #7df9ff, 0 0 2px #fff; }
  .balls :global(canvas.ufo) { position: absolute; left: 50%; top: 50%; z-index: 2; transform: translate(-50%, -50%); pointer-events: none; }
  .balls :global(.orbit) { position: absolute; left: 50%; top: 50%; z-index: -1; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.28); pointer-events: none; }
  .fx-atom :global(.orbit) { border-color: rgba(125, 249, 255, 0.45); }

  /* Sun: a breathing corona. */
  .fx-sun .face { animation: corona 3.2s ease-in-out infinite; }
  @keyframes corona {
    50% { box-shadow: inset -8px -12px 24px rgba(160, 60, 0, 0.25), 0 0 60px 14px rgba(255, 190, 60, 0.75), 0 0 120px 30px rgba(255, 140, 30, 0.25); }
  }
  /* Earth: oceans with drifting cloud bands. */
  .fx-earth .face { background:
      radial-gradient(ellipse 30% 18% at 30% 40%, rgba(120, 200, 120, 0.75), transparent 70%),
      radial-gradient(ellipse 22% 30% at 68% 62%, rgba(110, 190, 110, 0.7), transparent 70%),
      radial-gradient(circle at 32% 28%, #fff 0%, var(--c1) 22%, var(--c2) 78%, color-mix(in srgb, var(--c2) 55%, #000) 100%); }
  .fx-earth .face::after { content: ''; position: absolute; left: 0; top: 0; width: 200%; height: 100%;
    background: radial-gradient(ellipse 14% 7% at 20% 30%, rgba(255, 255, 255, 0.6), transparent 70%),
      radial-gradient(ellipse 18% 6% at 62% 55%, rgba(255, 255, 255, 0.5), transparent 70%),
      radial-gradient(ellipse 10% 5% at 38% 78%, rgba(255, 255, 255, 0.55), transparent 70%);
    background-size: 50% 100%; background-repeat: repeat-x; animation: clouds 16s linear infinite; }
  @keyframes clouds { to { translate: -50% 0; } }
  /* Research: a transient grating, written by two pulses and fading away. */
  .fringes { position: absolute; inset: -10%; background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0) 0, rgba(255, 255, 255, 0.55) 6%, rgba(255, 255, 255, 0) 12%); animation: grating 3.4s ease-out infinite; }
  @keyframes grating { 0% { opacity: 0; translate: 0 0; } 8% { opacity: 1; } 100% { opacity: 0; translate: 12% 0; } }
  /* Interests: soda fizz. */
  .bub { position: absolute; bottom: -12%; left: calc(14% + var(--k) * 11%); width: calc(6% + var(--k) * 1%); aspect-ratio: 1; border-radius: 50%; border: 1.5px solid rgba(255, 255, 255, 0.8); background: rgba(255, 255, 255, 0.15); animation: fizz calc(2.4s + var(--k) * 0.37s) ease-in infinite; animation-delay: calc(var(--k) * -0.61s); }
  @keyframes fizz { 0% { translate: 0 0; opacity: 0; } 15% { opacity: 1; } 50% { translate: 6px -60%; } 100% { translate: -4px -1100%; opacity: 0; } }
  /* Notes: Saturn's rings, back half behind the planet and front half over it. */
  .ring { position: absolute; left: 50%; top: 50%; width: 210%; height: 48%; border-radius: 50%; pointer-events: none;
    border: max(3px, 0.06em) solid rgba(230, 210, 170, 0.85); box-shadow: 0 0 0 max(3px, 0.05em) rgba(200, 175, 130, 0.35); translate: -50% -50%; rotate: -18deg; }
  .ring.back { z-index: -1; }
  .ring.front { z-index: 2; clip-path: inset(50% 0 0 0); }
  .stage.ready .ball { opacity: 1; }
  .ball span { padding: 0 8%; line-height: 1.05; pointer-events: none; }
  .ball:hover { scale: 1.08; }
  .ball:hover .face { box-shadow: inset -8px -12px 24px rgba(0, 0, 0, 0.2), 0 0 46px 2px color-mix(in srgb, var(--c2) 85%, transparent); }
  .ball:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  .ball.held { cursor: grabbing; scale: 1.1; }

  .caption { position: absolute; left: 0; bottom: 0; z-index: 3; padding: 40px 24px 22px; max-width: 640px; pointer-events: none;
    background: radial-gradient(ellipse 90% 100% at 0% 100%, rgba(10, 12, 18, 0.7), transparent 75%); }
