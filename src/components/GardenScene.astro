---
// Hand-drawn style ink scene: Ginkaku-ji (the Silver Pavilion) with its sand garden,
// white line work on the hero's gray. Shapes are filled with the background colour
// so nearer objects hide the lines behind them, like an inked manga panel.

const BG = '#3b3c42';

// Raked sand: wavy parallel lines between two horizontal bounds.
function rake(x0: number, x1: number, y0: number, y1: number, step: number, amp: number, period: number) {
  const out: string[] = [];
  for (let y = y0; y <= y1; y += step) {
    let d = `M${x0},${y}`;
    for (let x = x0; x <= x1; x += 10) {
      d += ` L${x},${(y + amp * Math.sin((x / period) * Math.PI * 2 + y * 0.15)).toFixed(1)}`;
    }
    out.push(d);
  }
  return out;
}

// Spiral-tipped cloud, the classic manga swirl.
function swirlCloud(cx: number, cy: number, w: number, flip = false) {
  const s = flip ? -1 : 1;
  const h = w * 0.22;
  let d = `M${cx - (s * w) / 2},${cy}`;
  const bumps = 4;
  for (let i = 0; i < bumps; i++) {
    const xa = cx - (s * w) / 2 + (s * w * i) / bumps;
    const xb = xa + (s * w) / bumps;
    d += ` Q${(xa + xb) / 2},${cy - h * (i % 2 ? 0.8 : 1.3)} ${xb},${cy}`;
  }
  // spiral at the end
  let r = h * 0.9;
  let a = 0;
  const ex = cx + (s * w) / 2;
  const sx = ex - s * r;
  for (let i = 0; i < 22; i++) {
    a += 0.42;
    r *= 0.93;
    d += ` L${(sx + s * r * Math.cos(a)).toFixed(1)},${(cy - r * Math.sin(a)).toFixed(1)}`;
  }
  return d;
}

const shoji = Array.from({ length: 15 }, (_, i) => 1012 + i * 24);
const balusters = Array.from({ length: 13 }, (_, i) => 1066 + i * 19);
const shingles1 = Array.from({ length: 22 }, (_, i) => 1035 + i * 14);
const shingles2 = Array.from({ length: 9 }, (_, i) => 1138 + i * 11);
const sand = rake(700, 1600, 712, 752, 7, 2.2, 70);
---
<svg class="garden" viewBox="600 60 1000 840" preserveAspectRatio="xMaxYMax meet" aria-hidden="true">
