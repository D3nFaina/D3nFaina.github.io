---
import Base from '../layouts/Base.astro';
import { interests } from '../data/life';
---
<Base title="Interests" description="Life outside the lab.">
  <header class="container page-head">
    <span class="eyebrow">Beyond the lab</span>
    <h1>Interests</h1>
    <p>What I do when the beamtime is over.</p>
  </header>
  <div class="container grid">
    {interests.map((it, i) => (
      <article class={`card it reveal${it.href || it.gallery ? ' go' : ''}`} style={`transition-delay:${i * 70}ms`}>
        {it.img
          ? <img class="meme" src={it.img} alt={`${it.title} meme`} loading="lazy" />
          : it.emoji && <div class="emo" aria-hidden="true">{it.emoji}</div>}
        <h2>{it.title}</h2>
        <p>{it.text}</p>
        {it.link && <a class="lnk" href={it.link.href}>{it.link.label} →</a>}
        {it.href && <a class="cover" href={it.href} aria-label={it.title}><span class="more">{it.title === 'Code' ? 'See projects' : 'See photographs'} →</span></a>}
        {it.gallery && <button class="cover" data-gallery={it.title} aria-label={`Show ${it.title} photos`}><span class="more">See {it.gallery.length} photos →</span></button>}
      </article>
    ))}
  </div>

  {interests.filter((it) => it.gallery).map((it) => (
    <dialog class="gallery" data-for={it.title}>
      <form method="dialog"><button class="close" aria-label="Close">×</button></form>
      <figure class="big">
        <button class="nav prev" aria-label="Previous photo">‹</button>
        <img alt="" />
        <button class="nav next" aria-label="Next photo">›</button>
        <figcaption></figcaption>
      </figure>
      <div class="thumbs">
        {it.gallery!.map((g) => (
          <button class="th" data-src={`/food/full/${g.f}.jpg`} data-caption={g.caption}>
            <img src={`/food/thumb/${g.f}.jpg`} alt={g.caption} width={g.w} height={g.h} loading="lazy" />
          </button>
        ))}
      </div>
    </dialog>
  ))}

  <script>
    // Cards with a gallery open it in a dialog, with previous/next and a thumbnail row.
    document.querySelectorAll<HTMLButtonElement>('[data-gallery]').forEach((btn) => {
      const box = document.querySelector<HTMLDialogElement>(`dialog[data-for="${btn.dataset.gallery}"]`)!;
      const ths = [...box.querySelectorAll<HTMLElement>('.th')];
      const img = box.querySelector<HTMLImageElement>('.big img')!;
      const cap = box.querySelector('figcaption')!;
      let at = 0;
      const show = (i: number) => {
        at = (i + ths.length) % ths.length;
        img.src = ths[at].dataset.src!; img.alt = cap.textContent = ths[at].dataset.caption!;
        ths.forEach((t, j) => t.classList.toggle('on', j === at));
      };
      btn.addEventListener('click', () => { show(0); box.showModal(); });
      ths.forEach((t, j) => t.addEventListener('click', () => show(j)));
      box.querySelector('.prev')!.addEventListener('click', () => show(at - 1));
      box.querySelector('.next')!.addEventListener('click', () => show(at + 1));
      box.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(at - 1); if (e.key === 'ArrowRight') show(at + 1); });
      box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
    });
  </script>
</Base>
<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .it { position: relative; padding: 30px; transition: transform .3s, border-color .3s; }
  .it:hover { transform: translateY(-3px); border-color: var(--accent); }
  .emo { font-size: 34px; width: 64px; height: 64px; display: grid; place-items: center; border-radius: 18px; background: var(--bg-soft); }
  .meme { display: block; width: 100%; height: 260px; object-fit: contain; border-radius: 14px; background: var(--bg-soft); }
  h2 { font-size: 26px; margin-top: 20px; }
  p { color: var(--ink-soft); margin: 10px 0 0; }
  .lnk { display: inline-block; margin-top: 14px; font-weight: 600; color: var(--accent); }
  .lnk:hover { text-decoration: underline; }

  /* The whole card is the link; the label sits where an inline link would. */
  .cover { position: absolute; inset: 0; border: 0; padding: 0 30px 26px; background: none; border-radius: inherit; cursor: pointer; display: flex; align-items: flex-end; font: inherit; text-align: left; }
  .go { padding-bottom: 62px; }
  .more { font-weight: 600; color: var(--accent); }
  .go:hover .more { text-decoration: underline; }
  .cover:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .gallery { border: 0; padding: 0; background: transparent; max-width: min(1100px, 94vw); max-height: 96vh; overflow: visible; }
  .gallery::backdrop { background: rgba(10, 10, 14, 0.9); }
  .big { position: relative; margin: 0; }
  .big img { display: block; max-width: 100%; max-height: 74vh; margin: 0 auto; border-radius: 10px; }
  .big figcaption { color: #eee; text-align: center; margin-top: 10px; font-size: 14.5px; }
  .thumbs { display: flex; gap: 10px; justify-content: center; margin-top: 14px; flex-wrap: wrap; }
  .th { padding: 0; border: 2px solid transparent; border-radius: 10px; overflow: hidden; background: none; cursor: pointer; opacity: .6; transition: opacity .2s, border-color .2s; }
  .th img { display: block; height: 72px; width: auto; }
  .th.on, .th:hover { opacity: 1; border-color: var(--accent); }
  .close { position: fixed; top: 14px; right: 18px; font-size: 34px; line-height: 1; color: #fff; background: none; border: 0; cursor: pointer; }
  .nav { position: absolute; top: 50%; transform: translateY(-50%); width: 46px; height: 46px; border-radius: 50%; border: 0; background: rgba(255,255,255,.14); color: #fff; font-size: 28px; cursor: pointer; }
  .nav:hover { background: rgba(255,255,255,.28); }
  .prev { left: -60px; } .next { right: -60px; }
  @media (max-width: 900px) {
    .prev { left: 8px; } .next { right: 8px; }
    .big img { max-height: 64vh; }
    .thumbs { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; padding-bottom: 4px; }
    .th { flex: none; } .th img { height: 56px; }
  }
  @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } }
</style>
