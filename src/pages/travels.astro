---
import Base from '../layouts/Base.astro';
import { geoNaturalEarth1, geoMercator, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import world50 from 'world-atlas/countries-50m.json';
import world10 from 'world-atlas/countries-10m.json';
import { places, countriesVisited } from '../data/life';
import starred from '../data/starred.json';

// Everything is drawn at build time into plain SVGs: no tiles, no API keys.
// starred.json = favourite places from Google Maps (Takeout "Saved Places.json"),
// filtered to sights and food; `t: 1` marks the few shown on the world map.
const W = 960, H = 470;
const countries = (feature(world as any, (world as any).objects.countries) as any).features
  .filter((f: any) => f.properties.name !== 'Antarctica');
const projection = geoNaturalEarth1().fitExtent([[4, 4], [W - 4, H - 4]], { type: 'FeatureCollection', features: countries } as any);
const path = geoPath(projection);
const visited = new Set(countriesVisited);

type Star = { n: string; a: number; o: number; c: string; t: number };
const stars = starred as Star[];
const byCountry = new Map<string, Star[]>();
for (const st of stars) byCountry.set(st.c, [...(byCountry.get(st.c) ?? []), st]);
const starCountries = [...byCountry.keys()].sort((x, y) => byCountry.get(y)!.length - byCountry.get(x)!.length);

const shapes = countries.map((f: any) => ({
  d: path(f) ?? '', name: f.properties.name as string,
  on: visited.has(f.properties.name), zoom: byCountry.has(f.properties.name),
}));
const pins = places.map((p, i) => {
  const [x, y] = projection([p.lng, p.lat]) ?? [0, 0];
  return { ...p, x, y, i };
});
const unknown = countriesVisited.filter((c) => !shapes.some((s: any) => s.name === c));
if (unknown.length) console.warn(`travels: not on the map: ${unknown.join(', ')}`);

// A five-pointed star centred on 0,0.
const starPath = (r: number) => Array.from({ length: 10 }, (_, k) => {
  const rr = k % 2 ? r * 0.45 : r, t = (Math.PI / 5) * k - Math.PI / 2;
  return `${k ? 'L' : 'M'}${(rr * Math.cos(t)).toFixed(2)} ${(rr * Math.sin(t)).toFixed(2)}`;
}).join('') + 'Z';
// Drop repeated points once coordinates are rounded (10m data has many per pixel).
const squash = (d: string) => d.replace(/([ML])(-?\d+),(-?\d+)/g, '$1$2,$3').split(/(?=[MZ])/).map((ring) => {
  let last = '';
  return ring.replace(/L(-?\d+,-?\d+)/g, (m, xy) => (xy === last ? '' : ((last = xy), m)));
}).join('');
const toXY = (pr: any, st: Star) => (pr([st.o, st.a]) ?? [0, 0]).map((v: number) => +v.toFixed(1));
const topStars = stars.filter((st) => st.t).map((st) => ({ ...st, xy: toXY(projection, st) }));

// One zoomed view per country: Mercator fitted to that country's stars, land clipped to the frame.
const f50 = (feature(world50 as any, (world50 as any).objects.countries) as any).features;
const f10 = (feature(world10 as any, (world10 as any).objects.countries) as any).features;
const views = starCountries.map((c) => {
  const ps = byCountry.get(c)!;
  const lo = ps.map((p) => p.o), la = ps.map((p) => p.a);
  const span = Math.max(Math.max(...lo) - Math.min(...lo), Math.max(...la) - Math.min(...la));
  const pad = Math.max(1, span * 0.18);
  const box = { type: 'MultiPoint', coordinates: [[Math.min(...lo) - pad, Math.min(...la) - pad], [Math.max(...lo) + pad, Math.max(...la) + pad]] };
  const pr = geoMercator().fitExtent([[30, 30], [W - 30, H - 30]], box as any).clipExtent([[0, 0], [W, H]]);
  const g = geoPath(pr).digits(0); // drawn 1:1, so whole pixels are plenty
  const land = (span < 3 ? f10 : f50).map((f: any) => ({ d: squash(g(f) ?? ''), home: f.properties.name === c })).filter((l: any) => l.d);
  // where to fly to on the world map before swapping in the detail view
  const [[x0, y0], [x1, y1]] = path.bounds(box as any);
  return { c, land, dots: ps.map((p) => ({ n: p.n, xy: toXY(pr, p) })), fly: [x0, y0, x1 - x0, y1 - y0].map((v) => +v.toFixed(1)) };
});

const albums = places.filter((p) => p.photos?.length);

const kinds = { lived: 'Lived', science: 'Beamtimes & science', travel: 'Travel' } as const;
---
<Base title="Travels" description="Places I have lived, worked and travelled.">
  <header class="container page-head">
    <span class="eyebrow">Travels</span>
    <h1>Around the world, one beamtime at a time</h1>
    <p>X-ray free-electron lasers are rare, so science keeps sending me places. Here is where I have lived, measured and wandered.</p>
  </header>

  <div class="container">
    <div class="counts reveal">
      <div class="count"><div class="n">{countriesVisited.length}</div><div class="t">countries visited</div></div>
      <div class="count"><div class="n">{places.filter((p) => p.kind !== 'travel').length}</div><div class="t">cities lived in or measured at</div></div>
      <div class="count"><div class="n">{places.length}</div><div class="t">places on the map</div></div>
    </div>

    <div class="legend">
      <span><i class="sw visited"></i>Visited</span>
      {Object.entries(kinds).map(([k, l]) => <span><i class={`dot ${k}`}></i>{l}</span>)}
      <span><svg class="sw-star" viewBox="-6 -6 12 12"><path d={starPath(5.5)} /></svg>Favourite spots</span>
    </div>

    <div class="map card">
      <div class="map-bar">
        <button class="back" hidden>← World</button>
        <span class="hint">Pick a country to see all my favourite spots there</span>
        <span class="here" hidden></span>
      </div>
      <div class="stage">
        <svg class="world" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`World map with ${countriesVisited.length} visited countries highlighted`}>
          <g class="land">
            {shapes.map((s: any) => <path d={s.d} class:list={{ on: s.on, zoom: s.zoom }} data-c={s.zoom ? s.name : undefined}><title>{s.name}</title></path>)}
          </g>
          <g class="pins">
            {pins.map((p) => (
              <g class={`pin ${p.kind}`} data-i={p.i} transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
                <circle class="halo" r="11" />
                <circle class="core" r="4.5" />
                <title>{p.name}: {p.note}</title>
              </g>
            ))}
          </g>
          <g class="stars">
            {topStars.map((st) => <path class="star" d={starPath(5.5)} transform={`translate(${st.xy[0]} ${st.xy[1]})`} data-n={st.n} data-c={st.c} />)}
          </g>
        </svg>
        {views.map((v) => (
          <svg class="detail" data-c={v.c} data-fly={v.fly.join(' ')} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Favourite spots in ${v.c}`}>
            <g class="land" set:html={v.land.map((l: any) => `<path d="${l.d}"${l.home ? ' class="home"' : ''}/>`).join('')} />
            <g class="stars">{v.dots.map((d) => <path class="star" d={starPath(7)} transform={`translate(${d.xy[0]} ${d.xy[1]})`} data-n={d.n} />)}</g>
          </svg>
        ))}
        <div class="tip" hidden></div>
      </div>
      <div class="chips">
        {starCountries.map((c) => <button class="chip" data-c={c}>{c === 'United States of America' ? 'USA' : c}<span>{byCountry.get(c)!.length}</span></button>)}
      </div>
    </div>

    <div class="grid">
      {places.map((p, i) => (
        <article class="place card reveal" style={`transition-delay:${(i % 4) * 60}ms`} data-i={i}>
          {p.photos?.length
            ? <img class="cover" src={p.photos[0].src} alt={p.photos[0].caption} loading="lazy" />
            : <div class={`band ${p.kind}`}></div>}
          <div class="pi">
            <div class="k"><i class={`dot ${p.kind}`}></i>{kinds[p.kind]}{p.year && <> · {p.year}</>}</div>
            <h3>{p.name}</h3>
            <div class="c">{p.country}</div>
            <p>{p.note}</p>
          </div>
        </article>
      ))}
    </div>
  </div>

  {albums.length > 0 && (
    <section class="container photos">
      <span class="eyebrow">Photographs</span>
      <h2>From the camera roll</h2>
      {albums.map((a) => (
        <div class="album">
          <h3>{a.name} <span>{a.country} · {a.year}</span></h3>
          <div class="masonry">
            {a.photos!.map((ph) => (
              <figure><button class="zoom" data-src={ph.src} data-caption={`${ph.caption}, ${a.country} ${a.year}`}>
                <img src={ph.src} alt={ph.caption} loading="lazy" /></button>
                <figcaption>{ph.caption}</figcaption></figure>
            ))}
          </div>
        </div>
      ))}
    </section>
  )}

  <dialog class="lightbox">
    <form method="dialog"><button class="close" aria-label="Close">×</button></form>
    <img alt="" />
    <p></p>
  </dialog>

  <script>
    const box = document.querySelector<HTMLDialogElement>('.lightbox')!;
    document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((b) => b.addEventListener('click', () => {
      box.querySelector('img')!.src = b.dataset.src!;
      box.querySelector('p')!.textContent = b.dataset.caption!;
      box.showModal();
    }));
    box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
  </script>

  <script>
    const map = document.querySelector<HTMLElement>('.map')!;
    const worldSvg = map.querySelector<SVGSVGElement>('svg.world')!;
    const tip = map.querySelector<HTMLElement>('.tip')!;
    const back = map.querySelector<HTMLButtonElement>('.back')!;
    const hint = map.querySelector<HTMLElement>('.hint')!;
    const here = map.querySelector<HTMLElement>('.here')!;
    const full = [0, 0, 960, 470];
    let current: string | null = null;

    // Fly the world map's viewBox from one box to another.
    const fly = (from: number[], to: number[], ms = 650) => new Promise<void>((done) => {
      const t0 = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / ms), e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        worldSvg.setAttribute('viewBox', from.map((v, i) => v + (to[i] - v) * e).join(' '));
        k < 1 ? requestAnimationFrame(step) : done();
      };
      requestAnimationFrame(step);
    });
    const fit = (b: number[]) => { // grow the box to the map's aspect ratio
      const [x, y, w, h] = b, r = 960 / 470;
      const W = Math.max(w, h * r), H = W / r;
      return [x + w / 2 - W / 2, y + h / 2 - H / 2, W, H];
    };
    const detail = (c: string) => map.querySelector<SVGSVGElement>(`svg.detail[data-c="${CSS.escape(c)}"]`);
    const chips = map.querySelectorAll<HTMLButtonElement>('.chip');

    async function open(c: string) {
      const d = detail(c);
      if (!d || c === current) return;
      if (current) { detail(current)!.classList.remove('show'); worldSvg.classList.remove('gone'); worldSvg.setAttribute('viewBox', full.join(' ')); }
      current = c;
      chips.forEach((b) => b.classList.toggle('on', b.dataset.c === c));
      hideTip();
      await fly(full, fit(d.dataset.fly!.split(' ').map(Number)));
      if (current !== c) return;
      worldSvg.classList.add('gone');
      d.classList.add('show');
      back.hidden = false; hint.hidden = true; here.hidden = false;
      here.textContent = `${c === 'United States of America' ? 'USA' : c} · ${d.querySelectorAll('.star').length} favourite spots`;
    }
    function close() {
      if (!current) return;
      detail(current)!.classList.remove('show');
      worldSvg.classList.remove('gone');
      const from = worldSvg.getAttribute('viewBox')!.split(' ').map(Number);
      current = null;
      chips.forEach((b) => b.classList.remove('on'));
      back.hidden = true; hint.hidden = false; here.hidden = true;
      hideTip();
      fly(from, full, 500);
    }
    back.addEventListener('click', close);
    chips.forEach((b) => b.addEventListener('click', () => (b.dataset.c === current ? close() : open(b.dataset.c!))));
    worldSvg.querySelectorAll<SVGPathElement>('.land path.zoom').forEach((p) => p.addEventListener('click', () => open(p.dataset.c!)));

    // Name tooltip on stars.
    const showTip = (el: Element) => {
      const r = el.getBoundingClientRect(), m = map.querySelector('.stage')!.getBoundingClientRect();
      tip.textContent = (el as HTMLElement).dataset.n!;
      tip.hidden = false;
      tip.style.left = `${r.left + r.width / 2 - m.left}px`;
      tip.style.top = `${r.top - m.top}px`;
    };
    function hideTip() { tip.hidden = true; }
    map.querySelectorAll('.star').forEach((st) => {
      st.addEventListener('pointerenter', () => showTip(st));
      st.addEventListener('pointerleave', hideTip);
      st.addEventListener('click', (e) => { e.stopPropagation(); showTip(st); });
    });
  </script>

  <script>
    const pins = document.querySelectorAll<SVGGElement>('.pin');
    const light = (i: string | undefined, on: boolean) =>
      pins.forEach((p) => p.classList.toggle('hot', on && p.dataset.i === i));
    document.querySelectorAll<HTMLElement>('.place').forEach((card) => {
      card.addEventListener('mouseenter', () => light(card.dataset.i, true));
      card.addEventListener('mouseleave', () => light(card.dataset.i, false));
      card.addEventListener('click', () => {
        light(card.dataset.i, true);
        document.querySelector('.map')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  </script>
</Base>

<style>
  .counts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 28px; }
  .count { border-top: 1.5px solid var(--ink); padding-top: 14px; }
  .n { font-family: var(--font-display); font-size: clamp(44px, 6vw, 72px); line-height: 1; }
  .t { color: var(--ink-mute); font-size: 14.5px; margin-top: 6px; }
  @media (max-width: 640px) { .counts { grid-template-columns: 1fr 1fr; } }

  .legend { display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 14px; font-size: 14.5px; color: var(--ink-soft); }
  .legend span, .k { display: inline-flex; align-items: center; gap: 8px; }
  .sw { width: 14px; height: 10px; border-radius: 3px; display: inline-block; }
  .sw.visited { background: color-mix(in srgb, var(--accent) 45%, var(--bg-soft)); }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .dot.lived, .band.lived { background: var(--violet); }
  .dot.science, .band.science { background: var(--cyan); }
  .dot.travel, .band.travel { background: var(--amber); }

  .map { padding: 12px; overflow: hidden; }
  .map { position: relative; }
  .map-bar { display: flex; align-items: center; gap: 12px; min-height: 34px; padding: 2px 4px 10px; font-size: 14px; color: var(--ink-mute); }
  .back { font: inherit; font-weight: 600; color: var(--ink); background: var(--bg-soft); border: 1px solid var(--line); border-radius: 999px; padding: 5px 12px; cursor: pointer; }
  .back:hover { border-color: var(--accent); }
  .here { color: var(--ink); font-weight: 600; }
  .stage { position: relative; }
  .map svg { display: block; width: 100%; height: auto; }
  .world { transition: opacity .25s; }
  .world.gone { opacity: 0; pointer-events: none; }
  .detail { position: absolute; inset: 0; opacity: 0; pointer-events: none; transition: opacity .35s; }
  .detail.show { opacity: 1; pointer-events: auto; }
  .land path.zoom { cursor: pointer; }
  .detail .land :global(path) { fill: color-mix(in srgb, var(--ink) 9%, var(--bg-elev)); stroke: var(--bg-elev); stroke-width: 0.8; }
  .detail .land :global(path.home) { fill: color-mix(in srgb, var(--accent) 30%, var(--bg-soft)); }
  .star { fill: #f6b400; stroke: color-mix(in srgb, #7a5300 55%, transparent); stroke-width: 0.6; cursor: pointer; transition: transform .15s; }
  .star:hover { fill: #ffcf33; }
  .sw-star { width: 14px; height: 14px; }
  .sw-star path { fill: #f6b400; }
  .tip { position: absolute; transform: translate(-50%, calc(-100% - 8px)); background: var(--ink); color: var(--bg); font-size: 12.5px; font-weight: 550; padding: 5px 9px; border-radius: 7px; white-space: nowrap; pointer-events: none; z-index: 3; max-width: 260px; overflow: hidden; text-overflow: ellipsis; box-shadow: 0 6px 18px -8px rgba(0,0,0,.5); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 14px 4px 4px; }
  .chip { font: inherit; font-size: 13.5px; color: var(--ink-soft); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 5px 11px; cursor: pointer; display: inline-flex; gap: 7px; align-items: center; transition: border-color .2s, background .2s; }
  .chip span { font-size: 12px; color: var(--ink-mute); }
  .chip:hover { border-color: #f6b400; }
  .chip.on { background: #f6b400; border-color: #f6b400; color: #1d1d22; }
  .chip.on span { color: #1d1d22; }
  @media (max-width: 640px) {
    .star { stroke: #f6b400; stroke-width: 4; stroke-linejoin: round; }  /* fatter stars without moving them */
    .chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-bottom: 6px; }
    .chip { flex: none; }
    .hint { font-size: 13px; }
  }
  .land path { fill: color-mix(in srgb, var(--ink) 12%, var(--bg-elev)); stroke: var(--bg-elev); stroke-width: 0.6; transition: fill .2s; }
  .land path.on { fill: color-mix(in srgb, var(--accent) 45%, var(--bg-soft)); }
  .land path:hover { fill: color-mix(in srgb, var(--ink) 22%, var(--bg-elev)); }
  .land path.on:hover { fill: color-mix(in srgb, var(--accent) 60%, var(--bg-soft)); }
  .pin .core { stroke: var(--bg-elev); stroke-width: 1.5; }
  .pin .halo { opacity: 0; transition: opacity .2s; }
  .pin.lived .core, .pin.lived .halo { fill: var(--violet); }
  .pin.science .core, .pin.science .halo { fill: var(--cyan); }
  .pin.travel .core, .pin.travel .halo { fill: var(--amber); }
  .pin.hot .halo, .pin:hover .halo { opacity: 0.35; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; margin-top: 28px; }
  .place { overflow: hidden; cursor: pointer; transition: transform .3s, border-color .3s; }
  .place:hover { transform: translateY(-3px); border-color: var(--accent); }
  .band { height: 6px; }
  .cover { display: block; width: 100%; height: 150px; object-fit: cover; }

  .photos { padding-top: 72px; }
  .photos h2 { font-size: clamp(30px, 4vw, 44px); margin-top: 10px; }
  .album { margin-top: 40px; }
  .album h3 { font-size: 22px; margin: 0 0 14px; }
  .album h3 span { font-family: var(--font-sans, inherit); font-size: 14px; color: var(--ink-mute); font-weight: 500; margin-left: 8px; }
  .masonry { columns: 3 260px; column-gap: 14px; }
  .masonry figure { break-inside: avoid; margin: 0 0 14px; }
  .zoom { display: block; padding: 0; border: 0; background: none; cursor: zoom-in; width: 100%; border-radius: 12px; overflow: hidden; }
  .zoom img { display: block; width: 100%; height: auto; transition: transform .5s ease; }
  .zoom:hover img { transform: scale(1.03); }
  figcaption { font-size: 13.5px; color: var(--ink-mute); margin-top: 6px; }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: min(1400px, 94vw); max-height: 94vh; }
  .lightbox::backdrop { background: rgba(10, 10, 14, 0.88); }
  .lightbox img { display: block; max-width: 100%; max-height: 86vh; border-radius: 10px; margin: 0 auto; }
  .lightbox p { color: #eee; text-align: center; margin: 10px 0 0; font-size: 14.5px; }
  .close { position: fixed; top: 14px; right: 18px; font-size: 34px; line-height: 1; color: #fff; background: none; border: 0; cursor: pointer; }
  .pi { padding: 18px 20px 20px; }
  .k { font-size: 12.5px; color: var(--ink-mute); font-weight: 550; }
  h3 { font-size: 24px; margin-top: 10px; }
  .c { color: var(--ink-mute); font-size: 14px; }
  p { margin: 10px 0 0; color: var(--ink-soft); font-size: 15px; }
</style>
