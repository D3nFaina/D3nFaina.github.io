---
import Base from '../layouts/Base.astro';
import { places } from '../data/life';
const kinds = { lived: 'Lived', science: 'Beamtimes & science', travel: 'Travel' } as const;
const countries = new Set(places.filter((p) => p.kind !== 'travel').map((p) => p.country)).size;
---
<Base title="Travels" description="Places I have lived, worked and travelled.">
  <header class="container page-head">
    <span class="eyebrow">Travels</span>
    <h1>Around the world, one beamtime at a time</h1>
    <p>X-ray free-electron lasers are rare, so science has taken me to {countries} countries. Here is where I have lived, measured and wandered.</p>
  </header>
  <div class="container">
    <div class="legend">
      {Object.entries(kinds).map(([k, l]) => <span><i class={`dot ${k}`}></i>{l}</span>)}
    </div>
    <div id="map" class="card" data-places={JSON.stringify(places)}></div>
    <div class="grid">
      {places.map((p, i) => (
        <article class="place card reveal" style={`transition-delay:${(i % 4) * 60}ms`} data-i={i}>
          <div class={`band ${p.kind}`}></div>
          <div class="pi">
            <div class="k"><i class={`dot ${p.kind}`}></i>{kinds[p.kind]}{p.year && <> · {p.year}</>}</div>
            <h3>{p.name}</h3>
            <div class="c">{p.country}</div>
            <p>{p.note}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
  <script>
    import L from 'leaflet';
    import 'leaflet/dist/leaflet.css';
    const el = document.getElementById('map')!;
    const places: { name: string; note: string; lat: number; lng: number; kind: 'lived' | 'science' | 'travel' }[] = JSON.parse(el.dataset.places!);
    const colors = { lived: '#7c5cff', science: '#06b6d4', travel: '#f59e0b' };
    const map = L.map(el, { scrollWheelZoom: false, worldCopyJump: true }).setView([40, 40], 2);
    const url = (t: string) => `https://{s}.basemaps.cartocdn.com/${t}_all/{z}/{x}/{y}{r}.png`;
    let layer: L.TileLayer | undefined;
    const setTiles = () => {
      if (layer) map.removeLayer(layer);
      const t = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      layer = L.tileLayer(url(t), { attribution: '&copy; OpenStreetMap &copy; CARTO', subdomains: 'abcd', maxZoom: 18 }).addTo(map);
    };
    setTiles();
    window.addEventListener('themechange', setTiles);
    const markers = places.map((p) =>
      L.circleMarker([p.lat, p.lng], { radius: 8, color: '#fff', weight: 2, fillColor: colors[p.kind], fillOpacity: 1 })
        .addTo(map).bindPopup(`<strong>${p.name}</strong><br>${p.note}`)
    );
    map.fitBounds(L.featureGroup(markers).getBounds().pad(0.15));
    document.querySelectorAll<HTMLElement>('.place').forEach((card) => card.addEventListener('click', () => {
      const m = markers[Number(card.dataset.i)];
      map.flyTo(m.getLatLng(), 6, { duration: 1.2 });
      m.openPopup();
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }));
  </script>
</Base>
<style>
  #map { height: min(520px, 62vh); overflow: hidden; z-index: 0; }
  .legend { display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 14px; font-size: 14.5px; color: var(--ink-soft); }
  .legend span, .k { display: inline-flex; align-items: center; gap: 8px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .dot.lived, .band.lived { background: var(--violet); }
  .dot.science, .band.science { background: var(--cyan); }
  .dot.travel, .band.travel { background: var(--amber); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; margin-top: 28px; }
  .place { overflow: hidden; cursor: pointer; transition: transform .3s, border-color .3s; }
  .place:hover { transform: translateY(-3px); border-color: var(--accent); }
  .band { height: 6px; }
  .pi { padding: 18px 20px 20px; }
  .k { font-size: 12.5px; color: var(--ink-mute); font-weight: 550; }
  h3 { font-size: 24px; margin-top: 10px; }
  .c { color: var(--ink-mute); font-size: 14px; }
  p { margin: 10px 0 0; color: var(--ink-soft); font-size: 15px; }
  :global(.leaflet-container) { font-family: var(--font-sans); background: var(--bg-soft); }
</style>
