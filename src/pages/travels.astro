---
import Base from '../layouts/Base.astro';
import { geoNaturalEarth1, geoPath, geoGraticule } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import { places, countriesVisited, upcoming } from '../data/life';
import photos from '../data/photos.json';
import { stars, byCountry, starCountries, frame, slug } from '../lib/stars';

// The world map is drawn at build time into a plain SVG (no tiles, no API keys), then redrawn in the
// browser from /geo/world.json with pastel land cover and in whichever projection the visitor picks.
// Zoomed country maps are drawn in the browser from /geo/<slug>.json.
const W = 960, H = 470;
const countries = (feature(world as any, (world as any).objects.countries) as any).features
  .filter((f: any) => f.properties.name !== 'Antarctica');
const projection = geoNaturalEarth1().fitExtent([[4, 4], [W - 4, H - 4]], { type: 'FeatureCollection', features: countries } as any);
const path = geoPath(projection);

// Visited = trip countries plus every country with a favourite spot.
const visitedList = [...new Set([...countriesVisited, ...starCountries])];
const visited = new Set(visitedList);

const soon = new Set(upcoming.map((u) => u.country));
const shapes = countries.map((f: any) => ({
  d: path(f) ?? '', name: f.properties.name as string,
  on: visited.has(f.properties.name), can: byCountry.has(f.properties.name), up: soon.has(f.properties.name),
}));
const sea = path({ type: 'Sphere' } as any) ?? '';
const grat = path(geoGraticule().step([15, 15])()) ?? '';
const pins = [...places, ...upcoming.map((u) => ({ ...u, kind: 'upcoming' as const, note: `${u.when}: ${u.note}` }))].map((p, i) => {
  const [x, y] = projection([p.lng, p.lat]) ?? [0, 0];
  return { ...p, x, y, i };
});

// A five-pointed star centred on 0,0 (the client draws the same shape).
const starPath = (r: number) => Array.from({ length: 10 }, (_, k) => {
  const rr = k % 2 ? r * 0.45 : r, t = (Math.PI / 5) * k - Math.PI / 2;
  return `${k ? 'L' : 'M'}${(rr * Math.cos(t)).toFixed(2)} ${(rr * Math.sin(t)).toFixed(2)}`;
}).join('') + 'Z';
const topStars = stars.filter((st) => st.t).map((st) => ({ ...st, xy: (projection([st.o, st.a]) ?? [0, 0]).map((v) => +v.toFixed(1)) }));

type Pic = { f: string; w: number; h: number };
const albums = places.filter((p) => p.album).map((p) => {
  const captions = new Map((p.photos ?? []).map((ph) => [ph.src.split('/').pop()!.replace('.jpg', ''), ph.caption]));
  const pics = ((photos as Record<string, Pic[]>)[p.album!] ?? []).map((ph) => ({ ...ph, caption: captions.get(ph.f) ?? '' }));
  // captioned favourites first, then the rest in date order
  pics.sort((x, y) => Number(!x.caption) - Number(!y.caption) || x.f.localeCompare(y.f));
  return { ...p, pics };
});
const albumsByCountry: Record<string, { name: string; year?: string; pics: { f: string; caption: string }[] }[]> = {};
for (const a of albums) {
  const c = a.country === 'USA' ? 'United States of America' : a.country;
  (albumsByCountry[c] ??= []).push({ name: a.name, year: a.year, pics: a.pics.map(({ f, caption }) => ({ f, caption })) });
}
const photoCount = albums.reduce((n, a) => n + a.pics.length, 0);

const kinds = { lived: 'Lived', science: 'Beamtimes & science', travel: 'Travel' } as const;
const label = (c: string) => (c === 'United States of America' ? 'USA' : c);
const chipList = [...starCountries].sort((x, y) => label(x).localeCompare(label(y)));
---
<Base title="Travels" description="Places I have lived, worked and travelled.">
  <header class="container page-head">
    <span class="eyebrow">Travels</span>
    <h1>Around the world, one beamtime at a time</h1>
    <p>X-ray free-electron lasers are rare, so science keeps sending me places. Here is where I have lived, measured and wandered.</p>
  </header>

  <div class="container">
    <div class="counts reveal">
      <div class="count"><div class="n">{visitedList.length}</div><div class="t">countries visited</div></div>
      <div class="count"><div class="n">{stars.length}</div><div class="t">favourite spots on the map</div></div>
      <div class="count"><div class="n">{photoCount}</div><div class="t">photos from the road</div></div>
    </div>

    <section class="soon card reveal" aria-labelledby="up-h">
      <h2 id="up-h"><i class="dot upcoming"></i>Upcoming</h2>
      <ol>
        {upcoming.map((u) => (
          <li>
            <span class="when">{u.when}</span>
            <span class="what"><b>{u.name}</b><span class="k">{u.kind === 'beamtime' ? 'Beamtime' : 'Travel'} · {u.country}</span></span>
            <span class="nt">{u.note}{u.link && <> · <a href={u.link}>read more</a></>}</span>
          </li>
        ))}
      </ol>
    </section>

    <div class="legend">
      <span><i class="sw visited"></i>Visited (in colour)</span><span><i class="sw faded"></i>Not yet</span>
      {Object.entries(kinds).map(([k, l]) => <span><i class={`dot ${k}`}></i>{l}</span>)}
      <span><i class="dot upcoming"></i>Upcoming</span>
      <span><svg class="sw-star" viewBox="-6 -6 12 12"><path d={starPath(5.5)} /></svg>Favourite spots</span>
    </div>

    <div class="map card" data-albums={JSON.stringify(albumsByCountry)}
      data-pins={JSON.stringify(pins.map((p) => [p.lng, p.lat]))} data-top={JSON.stringify(topStars.map((s) => [s.o, s.a]))}>
      <div class="map-bar">
        <button class="back" hidden>← World</button>
        <span class="hint">Click a country (or pick one from the list below the map) to see all my favourite spots there</span>
        <span class="here" hidden></span>
        <button class="launch" type="button" hidden title="Starship from Starbase, Boca Chica">🚀 Launch Starship</button>
      </div>
      <div class="stage">
        <svg class="world" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`World map with ${visitedList.length} visited countries highlighted`}>
          <defs><clipPath id="world-land"><path class="clip" d={shapes.map((s: any) => s.d).join('')} /></clipPath></defs>
          <path class="sea" d={sea} />
          <path class="grat" d={grat} />
          <path class="landbase" d={shapes.map((s: any) => s.d).join('')} />
          <g class="biomes" clip-path="url(#world-land)"></g>
          <g class="land">
            {shapes.map((s: any) => <path d={s.d} class:list={{ on: s.on, can: s.can, up: s.up }} data-c={s.name}><title>{s.name}</title></path>)}
          </g>
          <g class="marks">
            <g class="pins">
              {pins.map((p) => (
                <g class={`pin ${p.kind}`} data-i={p.i} transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
                  <circle class="halo" r="11" />
                  <circle class="core" r="4.5" />
                  <title>{p.name}: {p.note}</title>
                </g>
              ))}
            </g>
            <g class="stars">
              {topStars.map((st) => <path class="star" d={starPath(5.5)} transform={`translate(${st.xy[0]} ${st.xy[1]})`} data-n={st.n} />)}
            </g>
          </g>
        </svg>
        <svg class="detail" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Favourite spots in the selected country"></svg>
        <div class="loading" hidden>Loading map…</div>
        <div class="proj">
          <div class="proj-buttons" role="radiogroup" aria-label="World map projection"></div>
          <p class="proj-note"></p>
        </div>
        <div class="tip" hidden></div>
      </div>
      <div class="biome-key" aria-hidden="true">
        {[['desert', 'Desert'], ['dry', 'Steppe & savanna'], ['grass', 'Grassland & farmland'], ['forest', 'Forest'], ['jungle', 'Rainforest'], ['cold', 'Snow & tundra'], ['ice', 'Ice']].map(([k, l]) => <span><i style={`background: var(--${k})`}></i>{l}</span>)}
      </div>
      <div class="strip" hidden></div>
      <details class="pick">
        <summary><span class="pick-label">Pick a country</span> <span class="pick-n">{chipList.length} with favourite spots</span></summary>
        <div class="chips">
        {chipList.map((c) => <button class="chip" data-c={c} data-slug={slug(c)} data-box={JSON.stringify(frame(c).box)}>{label(c)}<span>{byCountry.get(c)!.length}</span></button>)}
        </div>
      </details>
    </div>

    <div class="grid">
      {places.map((p, i) => (
        <article class="place card reveal" style={`transition-delay:${(i % 4) * 60}ms`} data-i={i}>
          {p.photos?.length
            ? <img class="cover" src={p.photos[0].src.replace('/full/', '/thumb/')} alt={p.photos[0].caption} loading="lazy" />
            : <div class={`band ${p.kind}`}></div>}
          <div class="pi">
            <div class="k"><i class={`dot ${p.kind}`}></i>{kinds[p.kind]}{p.year && <> · {p.year}</>}</div>
            <h3>{p.name}</h3>
            <div class="c">{p.country}</div>
            <p>{p.note}</p>
          </div>
        </article>
      ))}
    </div>
  </div>

  {albums.length > 0 && (
    <section class="container photos" id="photographs">
      <span class="eyebrow">Photographs</span>
      <h2>From the camera roll</h2>
      {albums.map((a) => (
        <div class="album" id={`album-${a.album}`}>
          <h3>{a.name} <span>{a.country} · {a.year} · {a.pics.length} photos</span></h3>
          <div class="masonry">
            {a.pics.map((ph) => (
              <figure><button class="photo" data-src={`/travels/full/${ph.f}.jpg`} data-caption={[ph.caption, `${a.name} ${a.year}`].filter(Boolean).join(' · ')}>
                <img src={`/travels/thumb/${ph.f}.jpg`} alt={ph.caption || `${a.name}, ${a.year}`} width={ph.w} height={ph.h} loading="lazy" /></button>
                {ph.caption && <figcaption>{ph.caption}</figcaption>}</figure>
            ))}
          </div>
        </div>
      ))}
    </section>
  )}

  <dialog class="lightbox">
    <form method="dialog"><button class="close" aria-label="Close">×</button></form>
    <button class="nav prev" aria-label="Previous photo">‹</button>
    <img alt="" />
    <button class="nav next" aria-label="Next photo">›</button>
    <p></p>
  </dialog>

  <script>
    // Lightbox with previous/next across the photos of one album (or the zoomed country's strip).
    const box = document.querySelector<HTMLDialogElement>('.lightbox')!;
    let set: HTMLElement[] = [], at = 0;
    const show = () => {
      const b = set[at];
      box.querySelector('img')!.src = b.dataset.src!;
      box.querySelector('p')!.textContent = b.dataset.caption!;
    };
    const step = (d: number) => { at = (at + d + set.length) % set.length; show(); };
    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.photo');
      if (!b) return;
      const group = b.closest('.masonry, .strip');
      set = group ? [...group.querySelectorAll<HTMLElement>('.photo')] : [b];
      at = set.indexOf(b);
      show();
      box.showModal();
    });
    box.querySelector('.prev')!.addEventListener('click', () => step(-1));
    box.querySelector('.next')!.addEventListener('click', () => step(1));
    box.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') step(-1); if (e.key === 'ArrowRight') step(1); });
    box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
  </script>

  <script>
    import {
      geoNaturalEarth1, geoMercator, geoEqualEarth, geoOrthographic, geoPath, geoGraticule, geoInterpolate, geoRotation,
      type GeoProjection,
    } from 'd3-geo';
    // @ts-ignore: no bundled types
    import { geoWinkel3 } from 'd3-geo-projection';

    const W = 960, H = 470;
    const map = document.querySelector<HTMLElement>('.map')!;
    const worldSvg = map.querySelector<SVGSVGElement>('svg.world')!;
    const detailSvg = map.querySelector<SVGSVGElement>('svg.detail')!;
    const stage = map.querySelector<HTMLElement>('.stage')!;
    const tip = map.querySelector<HTMLElement>('.tip')!;
    const back = map.querySelector<HTMLButtonElement>('.back')!;
    const hint = map.querySelector<HTMLElement>('.hint')!;
    const here = map.querySelector<HTMLElement>('.here')!;
    const loading = map.querySelector<HTMLElement>('.loading')!;
    const proj = map.querySelector<HTMLElement>('.proj')!;
    const strip = map.querySelector<HTMLElement>('.strip')!;
    const chips = [...map.querySelectorAll<HTMLButtonElement>('.chip')];
    const picker = map.querySelector<HTMLDetailsElement>('.pick')!, pickLabel = picker.querySelector<HTMLElement>('.pick-label')!;
    const albums: Record<string, { name: string; year?: string; pics: { f: string; caption: string }[] }[]> = JSON.parse(map.dataset.albums!);
    const pinLL: [number, number][] = JSON.parse(map.dataset.pins!);
    const topLL: [number, number][] = JSON.parse(map.dataset.top!);
    const canZoom = new Set(chips.map((b) => b.dataset.c!));
    const full = [0, 0, W, H];
    const BIOMES = ['desert', 'dry', 'grass', 'forest', 'jungle', 'cold', 'ice'];

    type World = { countries: { n: string; t: string; c: any }[]; biomes: Record<string, number[][][][]> };
    type Geo = { c: string; box: number[]; span: number; land: { home: boolean; rings: number[][][] }[]; stars: [number, number, string][] };

    // Five ways to flatten the whole globe. The zoomed country maps always use Mercator: at that
    // scale every projection looks the same.
    let spin: [number, number, number] = [-15, -30, 0];
    const PROJECTIONS: { id: string; name: string; note: string; make: () => GeoProjection }[] = [
      {
        id: 'natural', name: 'Natural Earth',
        note: 'Drawn by eye to simply look right: no property is exactly true and none is badly off. A good everyday world map.',
        make: () => geoNaturalEarth1(),
      },
      {
        id: 'mercator', name: 'Mercator',
        note: 'Keeps angles and local shapes true, so a compass bearing is a straight line: made for sailors, used by web maps. Areas balloon towards the poles: Greenland looks as big as Africa, which is 14 times larger.',
        make: () => geoMercator(),
      },
      {
        id: 'equal', name: 'Equal Earth',
        note: 'Every country gets its true share of area, with shapes kept pleasant. The fair choice for comparing how big places really are.',
        make: () => geoEqualEarth(),
      },
      {
        id: 'winkel', name: 'Winkel tripel',
        note: 'Balances the errors in area, direction and distance, with the smallest overall distortion. National Geographic’s world map since 1998.',
        make: () => geoWinkel3(),
      },
      {
        id: 'ortho', name: 'Globe',
        note: 'Orthographic: the Earth as seen from deep space, in true perspective. Only half the world at a time, so drag to spin it.',
        make: () => geoOrthographic().rotate(spin),
      },
    ];
    let projId = 'natural';
    try { projId = localStorage.getItem('travels-world-projection') || projId; } catch {}
    if (!PROJECTIONS.some((p) => p.id === projId)) projId = 'natural';

    const ns = 'http://www.w3.org/2000/svg';
    const el = (name: string, attrs: Record<string, string> = {}) => {
      const e = document.createElementNS(ns, name);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
      return e;
    };
    const starD = (r: number) => Array.from({ length: 10 }, (_, k) => {
      const rr = k % 2 ? r * 0.45 : r, t = (Math.PI / 5) * k - Math.PI / 2;
      return `${k ? 'L' : 'M'}${(rr * Math.cos(t)).toFixed(2)} ${(rr * Math.sin(t)).toFixed(2)}`;
    }).join('') + 'Z';
    const geom = (t: string, c: any) => ({ type: t, coordinates: c }) as any;

    // World data (country outlines and land cover), fetched once.
    const worldData: Promise<World> = fetch('/geo/world.json').then((r) => r.json());

    // ---- world map ----
    let wp: GeoProjection = geoNaturalEarth1();
    let wpath = geoPath(wp);
    const wSea = worldSvg.querySelector('.sea')!, wGrat = worldSvg.querySelector('.grat')!;
    const wBase = worldSvg.querySelector('.landbase')!, wClip = worldSvg.querySelector('.clip')!;
    const wBiomes = worldSvg.querySelector('.biomes')!;
    const countryEls = new Map([...worldSvg.querySelectorAll<SVGPathElement>('.land path')].map((p) => [p.dataset.c!, p]));
    const pinEls = [...worldSvg.querySelectorAll<SVGGElement>('.pin')];
    const starEls = [...worldSvg.querySelectorAll<SVGPathElement>('.stars .star')];
    const biomeEls = new Map<string, SVGPathElement>();
    let W0: World | null = null;

    function setWorldProjection() {
      const p = PROJECTIONS.find((q) => q.id === projId)!.make();
      if (projId === 'ortho') p.fitExtent([[4, 4], [W - 4, H - 4]], { type: 'Sphere' } as any);
      else p.fitExtent([[4, 4], [W - 4, H - 4]], { type: 'FeatureCollection', features: W0!.countries.map((c) => ({ type: 'Feature', geometry: geom(c.t, c.c) })) } as any);
      p.clipExtent([[0, 0], [W, H]]);
      wp = p; wpath = geoPath(p);
    }
    function drawWorld() {
      if (!W0) return;
      wSea.setAttribute('d', wpath({ type: 'Sphere' } as any) ?? '');
      wGrat.setAttribute('d', wpath(geoGraticule().step([15, 15])()) ?? '');
      let all = '';
      for (const c of W0.countries) {
        const d = wpath(geom(c.t, c.c)) ?? '';
        all += d;
        const e = countryEls.get(c.n);
        if (e) e.setAttribute('d', d);
      }
      wBase.setAttribute('d', all); wClip.setAttribute('d', all);
      for (const b of BIOMES) {
        let e = biomeEls.get(b);
        if (!e) { e = el('path', { class: b }) as SVGPathElement; biomeEls.set(b, e); wBiomes.append(e); }
        e.setAttribute('d', wpath(geom('MultiPolygon', W0.biomes[b])) ?? '');
      }
      const place = (e: SVGElement, ll: [number, number]) => {
        const xy = wp(ll), seen = xy && wpath({ type: 'Point', coordinates: ll } as any);
        e.style.display = seen ? '' : 'none';
        if (seen) e.setAttribute('transform', `translate(${xy![0].toFixed(1)} ${xy![1].toFixed(1)})`);
      };
      pinEls.forEach((e, i) => place(e, pinLL[i]));
      starEls.forEach((e, i) => place(e, topLL[i]));
    }
    worldData.then((w) => { W0 = w; setWorldProjection(); drawWorld(); worldSvg.classList.add('ready'); });

    // Projection picker (world view only).
    const buttons = proj.querySelector<HTMLElement>('.proj-buttons')!;
    const note = proj.querySelector<HTMLElement>('.proj-note')!;
    for (const p of PROJECTIONS) {
      const b = document.createElement('button');
      b.type = 'button'; b.textContent = p.name; b.dataset.id = p.id; b.setAttribute('role', 'radio');
      b.addEventListener('click', async () => {
        projId = p.id;
        try { localStorage.setItem('travels-world-projection', p.id); } catch {}
        syncPicker();
        await worldData;
        worldSvg.classList.add('swap');
        setTimeout(() => { setWorldProjection(); drawWorld(); worldSvg.classList.remove('swap'); }, 150);
      });
      buttons.append(b);
    }
    function syncPicker() {
      const p = PROJECTIONS.find((q) => q.id === projId)!;
      buttons.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.id === p.id)));
      note.textContent = p.note;
      worldSvg.classList.toggle('globe', p.id === 'ortho');
    }
    syncPicker();

    // In globe view, Rick's saucer orbits the Earth (three.js, loaded only when needed). Every so
    // often Rick or Morty says something, and grabbing the ship makes Rick complain.
    const stageEl = map.querySelector<HTMLElement>('.stage')!;
    type Ship = { resize(): void; start(): void; stop(): void; grab(x: number, y: number): boolean; drag(x: number, y: number): void; release(): void;
      launch(site: () => { n: any; e: any } | null, on?: (s: 'sep' | 'done') => void): void };
    let saucer: Ship | null = null, saucerCanvas: HTMLCanvasElement | null = null;
    const saucerGeom = () => {
      const r = worldSvg.getBoundingClientRect(), k = r.width / W, [tx, ty] = wp.translate();
      return { w: r.width, h: r.height, cx: tx * k, cy: ty * k, R: wp.scale() * k };
    };
    // What Rick and Morty say. Every line goes through one queue, so nobody talks over anybody:
    // a line only counts down while it can be seen, and the next waits for it to finish.
    type Who = 'rick' | 'morty';
    type Line = [Who, string];
    const TALK: Line[][] = [
      [['rick', 'Wubba lubba dub dub!'], ['morty', 'Oh jeez, Rick, d-don’t shout in the cockpit!']],
      [['rick', 'I turned myself into a pickle, Morty!'], ['morty', 'Aw geez, Rick, n-not again…']],
      [['rick', 'Rikki-tikki-tavi, biatch!'], ['morty', 'Wh-what does that even mean, Rick?']],
      [['rick', 'Uh-oh, somersault jump!'], ['morty', 'Rick, I-I think we’re going too fast!']],
      [['rick', 'Morty, this planet is *burp* a dump.'], ['morty', 'Aw, c’mon Rick, it’s kinda nice.']],
      [['rick', 'Ultrafast X-rays, Morty. Femtoseconds! *burp*'], ['morty', 'Oh man, I don’t even know what a femtosecond is.']],
      [['rick', 'Get schwifty!']],
      [['morty', 'Oh jeez, Rick!'], ['rick', 'What, Morty? *burp* What now?']],
      [['morty', 'R-Rick, why are we going in circles?'], ['rick', 'Because orbital mechanics, Morty! *burp*']],
      [['morty', 'Oh man, oh man, oh man…'], ['rick', 'Relax, Morty. I’ve done this drunk a thousand times.']],
      [['morty', 'Rick, I gotta be home before dinner.'], ['rick', 'Dinner is a construct, Morty.']],
      [['morty', 'Aw geez, I think I’m gonna be sick.'], ['rick', 'Not on the upholstery, Morty!']],
      [['morty', 'Is th-that Den’s house down there?'], ['rick', 'Probably. Wave, Morty. *burp*']],
    ];
    const GRAB = [
      'Hey! Put me *burp* down, you grabby little primate!', 'Put the ship DOWN! This isn’t a petting zoo!',
      'Get your sweaty cursor off my ship!', 'Oh, real mature. Put me down!',
    ];
    const SCARED = ['Aaah! Rick, w-we’re being abducted!', 'Oh jeez oh jeez oh jeez!', 'R-Rick, a giant hand has us!'];
    const pick = <T,>(l: T[]) => l[Math.floor(Math.random() * l.length)];
    const quip = document.createElement('div'); quip.className = 'quip'; quip.hidden = true; quip.setAttribute('aria-live', 'polite');
    type Said = { who: Who; text: string; ms: number; loud: boolean };
    const queue: Said[] = [];
    let cur: Said | null = null, left = 0, lastFrame = 0, quiet = 0;
    let shipAt = { x: 0, y: 0, r: 0, front: false };
    // Queue lines; `loud` ones (the launch commentary) show even while the saucer is behind the globe.
    const speak = (lines: Line[], loud = false) => {
      // A loud line must not get stuck behind a quiet one waiting for the saucer to come round.
      if (loud) { for (const q of queue) q.loud = true; if (cur) cur.loud = true; }
      for (const [who, text] of lines) queue.push({ who, text, ms: 1500 + text.length * 38, loud });
    };
    // Grabbing the ship gets an answer straight away; whatever was queued carries on afterwards.
    const blurt = (lines: Line[]) => {
      if (cur) { queue.unshift(cur); cur = null; }
      queue.unshift(...lines.map(([who, text]) => ({ who, text, ms: 1500 + text.length * 38, loud: false })));
    };
    const idle = () => !cur && queue.length === 0;
    const show = (l: Said) => {
      cur = l; left = l.ms;
      quip.className = `quip ${l.who}`; quip.innerHTML = `<b>${l.who === 'rick' ? 'Rick' : 'Morty'}</b> `;
      quip.append(l.text);
    };
    const placeQuip = (p: typeof shipAt) => {
      shipAt = p;
      const now = performance.now(), dt = lastFrame ? Math.min(100, now - lastFrame) : 0; lastFrame = now;
      if (cur && (p.front || cur.loud)) { left -= dt; if (left <= 0) { cur = null; quiet = now; } }
      if (!cur && queue.length && (p.front || queue[0].loud) && now - quiet > 350) show(queue.shift()!);
      if (!cur || (!p.front && !cur.loud)) { quip.hidden = true; return; }
      quip.hidden = false;
      quip.classList.toggle('free', !p.front);
      if (!p.front) { quip.style.transform = 'translate(12px, 12px)'; return; }
      // Keep the bubble inside the map; above the ship, or below it near the top edge. The tail
      // points at whoever is talking: Morty sits on the left of the cockpit, Rick on the right.
      const w = quip.offsetWidth, h = quip.offsetHeight, sw = stageEl.clientWidth;
      const ax = p.x + (cur.who === 'rick' ? 0.3 : -0.3) * p.r;
      const x = Math.max(4, Math.min(sw - w - 4, ax - w / 2));
      const below = p.y - p.r * 0.9 - h - 10 < 0;
      const y = below ? p.y + p.r * 0.9 + 10 : p.y - p.r * 0.9 - h - 10;
      quip.classList.toggle('below', below);
      quip.style.setProperty('--tail', `${Math.max(14, Math.min(w - 14, ax - x))}px`);
      quip.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
    };
    // Small talk while nothing else is going on, taking turns over who starts.
    let chatter = 0, chatting = false, opener: Who = 'morty';
    const chat = () => {
      if (chatting) return;
      chatting = true;
      const tick = () => {
        if (!chatting) return;
        if (idle() && shipAt.front && !held && !busy && performance.now() - quiet > 4000 + Math.random() * 5000) {
          opener = opener === 'rick' ? 'morty' : 'rick';
          speak(pick(TALK.filter((x) => x[0][0] === opener)));
        }
        chatter = window.setTimeout(tick, 1000);
      };
      chatter = window.setTimeout(tick, 2500);
    };
    const hush = () => { chatting = false; clearTimeout(chatter); queue.length = 0; cur = null; quip.hidden = true; };
    async function syncSaucer() {
      const show = projId === 'ortho' && !!W0 && !worldSvg.classList.contains('gone') && !worldSvg.classList.contains('flying');
      launchBtn.hidden = !show;
      if (!show) { saucer?.stop(); hush(); if (saucerCanvas) saucerCanvas.hidden = true; return; }
      if (!saucerCanvas) {
        saucerCanvas = document.createElement('canvas'); saucerCanvas.className = 'saucer'; saucerCanvas.setAttribute('aria-hidden', 'true');
        stageEl.append(saucerCanvas, quip);
        const { mountSaucer } = await import('../lib/saucer');
        saucer = mountSaucer(saucerCanvas, saucerGeom, { a: 1.3, incl: 74, tilt: -12, T: 18, size: 0.24, wander: true, onFrame: placeQuip });
      }
      saucerCanvas.hidden = false; saucer?.resize(); saucer?.start(); chat();
    }
    new MutationObserver(() => syncSaucer()).observe(worldSvg, { attributes: true, attributeFilter: ['class'] });
    window.addEventListener('resize', () => saucer && projId === 'ortho' && saucer.resize());

    // Starship from Starbase, Boca Chica: spin the globe there, launch, and let Rick comment.
    const BOCA: [number, number] = [-97.157, 25.997];
    const launchBtn = map.querySelector<HTMLButtonElement>('.launch')!;
    let busy = false;
    const unit = (lon: number, lat: number) => {
      const [l, f] = geoRotation(spin)([lon, lat]).map((d) => (d * Math.PI) / 180);
      return [Math.cos(f) * Math.sin(l), Math.sin(f), Math.cos(f) * Math.cos(l)];
    };
    const bocaSite = () => {
      const n = unit(...BOCA), q = unit(BOCA[0] + 0.5, BOCA[1]);
      const e = q.map((v, i) => v - n[i]), en = Math.hypot(...e);
      return { n: { x: n[0], y: n[1], z: n[2] }, e: { x: e[0] / en, y: e[1] / en, z: e[2] / en } };
    };
    const MUSK_GO: Line[][] = [
      [['morty', 'Whoa, Rick, l-look! A rocket!'], ['rick', 'Pfft. Elon’s big shiny *burp* bottle rocket, Morty.']],
      [['rick', 'Oh great, Musk is compensating again.'], ['morty', 'Aw geez Rick, it’s kinda cool though.']],
      [['morty', 'Is that Starship?!'], ['rick', 'It’s a grain silo with a Twitter account, Morty.']],
      [['rick', 'Thirty-three engines, Morty. I run this thing on one.'], ['morty', 'One what, Rick?'], ['rick', 'Exactly.']],
    ];
    const MUSK_SEP: Line[][] = [
      [['rick', 'Hot staging. Cute. I did that in my garage in ’86.']],
      [['morty', 'Wh-why did it break in half?!'], ['rick', 'That’s on purpose, Morty. *burp* Mostly.']],
      [['rick', 'Ten bucks says he posts a meme about this in five minutes.']],
    ];
    const MUSK_CATCH: Line[][] = [
      [['morty', 'Whoa! The tower caught it with chopsticks!'], ['rick', 'Okay, the chopsticks are… *burp* kinda neat. Don’t tell him I said that.']],
      [['morty', 'Rick, it landed right back in the tower!'], ['rick', 'Big deal. I park the cruiser drunk every night.']],
    ];
    const MUSK_BOOM: Line[][] = [
      [['morty', 'Oh jeez, Rick, it blew up!'], ['rick', 'Rapid unscheduled disassembly, Morty. That’s Elon for “kaboom”.']],
      [['rick', 'And there goes the ship. *burp* Called it.'], ['morty', 'Aw man, w-were there people on it?'], ['rick', 'Just a banana for scale, Morty.']],
      [['morty', 'Th-that wasn’t supposed to happen, right?'], ['rick', 'He’ll call it “gathering data”, Morty.']],
    ];
    const MUSK_END: Line[][] = [
      [['rick', 'Call me when you’ve actually been to Mars, Elon. Oh wait, I have. *burp*']],
      [['morty', 'D-do you think he’ll really get to Mars?'], ['rick', 'Mars, Morty? I’ve got a portal gun. Who needs Mars?']],
    ];
    launchBtn.addEventListener('click', async () => {
      if (busy || !saucer) return;
      busy = true; launchBtn.disabled = true;
      await turnTo(BOCA[0] + 42, BOCA[1] - 22, 1100); // pad towards the upper-left limb, so the climb is seen side-on
      const three = await import('three');
      const site = () => {
        const s = bocaSite();
        return { n: new three.Vector3(s.n.x, s.n.y, s.n.z), e: new three.Vector3(s.e.x, s.e.y, s.e.z) };
      };
      speak(pick(MUSK_GO), true);
      saucer.launch(site, (st) => {
        if (st === 'sep') speak(pick(MUSK_SEP), true);
        else if (st === 'boom') speak(pick(MUSK_BOOM), true);
        else if (st === 'catch') speak(pick(MUSK_CATCH), true);
        else if (st === 'coast') speak(pick(MUSK_END), true);
        else { busy = false; launchBtn.disabled = false; }
      });
    });

    // Grab the saucer. Runs in the capture phase so the globe does not spin at the same time.
    let held = false;
    const local = (e: PointerEvent) => {
      const r = stageEl.getBoundingClientRect();
      return [Math.max(30, Math.min(r.width - 30, e.clientX - r.left)), Math.max(30, Math.min(r.height - 30, e.clientY - r.top))] as const;
    };
    stageEl.addEventListener('pointerdown', (e) => {
      if (!saucer || saucerCanvas?.hidden || !saucer.grab(...local(e))) return;
      e.stopPropagation(); e.preventDefault(); held = true;
      stageEl.classList.add('holding'); stageEl.setPointerCapture(e.pointerId);
      blurt([['rick', pick(GRAB)], ['morty', pick(SCARED)]]);
    }, { capture: true });
    stageEl.addEventListener('pointermove', (e) => { if (held) { e.stopPropagation(); saucer!.drag(...local(e)); } }, { capture: true });
    const drop = (e: PointerEvent) => {
      if (!held) return;
      held = false; stageEl.classList.remove('holding'); saucer!.release();
      try { stageEl.releasePointerCapture(e.pointerId); } catch {}
      // Drop whatever is left of the grab reaction, then Rick has the last word.
      const grabby = (l: Said | null) => !!l && (GRAB.includes(l.text) || SCARED.includes(l.text));
      if (grabby(cur)) cur = null;
      for (let i = queue.length - 1; i >= 0; i--) if (grabby(queue[i])) queue.splice(i, 1);
      blurt([['rick', 'Finally. *burp* Amateur.']]);
      const stopClick = (ev: Event) => ev.stopPropagation();
      stageEl.addEventListener('click', stopClick, { capture: true, once: true });
      setTimeout(() => stageEl.removeEventListener('click', stopClick, { capture: true }), 50);
    };
    stageEl.addEventListener('pointerup', drop, { capture: true });
    stageEl.addEventListener('pointercancel', drop, { capture: true });

    // Drag to spin the globe.
    let drag: { x: number; y: number; r: [number, number, number]; moved: boolean } | null = null;
    worldSvg.addEventListener('pointerdown', (e) => {
      if (projId !== 'ortho' || current) return;
      drag = { x: e.clientX, y: e.clientY, r: [...spin] as [number, number, number], moved: false };
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const k = 180 / worldSvg.getBoundingClientRect().height;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      if (Math.abs(dx) + Math.abs(dy) > 3) drag.moved = true;
      if (!drag.moved) return;
      spin = [drag.r[0] + dx * k, Math.max(-80, Math.min(80, drag.r[1] - dy * k)), 0];
      wp.rotate(spin); hideTip();
      requestAnimationFrame(drawWorld);
    });
    window.addEventListener('pointerup', () => {
      if (drag?.moved) { const stop = (ev: Event) => { ev.stopPropagation(); }; worldSvg.addEventListener('click', stop, { capture: true, once: true }); }
      drag = null;
    });

    // Spin the globe to face a place.
    const turnTo = (lon: number, lat: number, ms = 700) => new Promise<void>((done) => {
      const i = geoInterpolate([-spin[0], -spin[1]], [lon, lat]), t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / ms), e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        const [x, y] = i(e);
        spin = [-x, -y, 0]; wp.rotate(spin); drawWorld();
        k < 1 ? requestAnimationFrame(tick) : done();
      };
      requestAnimationFrame(tick);
    });

    // ---- zoomed country ----
    function draw(g: Geo, w: World) {
      const p = geoMercator();
      const [x0, y0, x1, y1] = g.box;
      p.fitExtent([[30, 30], [W - 30, H - 30]], { type: 'MultiPoint', coordinates: [[x0, y0], [x1, y1]] } as any);
      p.clipExtent([[0, 0], [W, H]]);
      const path = geoPath(p);
      const step = g.span > 25 ? 10 : g.span > 6 ? 5 : g.span > 2 ? 2 : 1;
      detailSvg.replaceChildren();
      const lands = g.land.map((l) => ({ home: l.home, d: path({ type: 'Polygon', coordinates: l.rings } as any) ?? '' }));
      const all = lands.map((l) => l.d).join('');
      const defs = el('defs'), clip = el('clipPath', { id: 'detail-land' });
      clip.append(el('path', { d: all })); defs.append(clip);
      detailSvg.append(defs);
      detailSvg.append(el('rect', { class: 'sea', width: String(W), height: String(H) }));
      detailSvg.append(el('path', { class: 'grat', d: path(geoGraticule().step([step, step])()) ?? '' }));
      detailSvg.append(el('path', { class: 'landbase', d: all }));
      const bio = el('g', { class: 'biomes', 'clip-path': 'url(#detail-land)' });
      for (const b of BIOMES) bio.append(el('path', { class: b, d: path(geom('MultiPolygon', w.biomes[b])) ?? '' }));
      detailSvg.append(bio);
      const land = el('g', { class: 'land' });
      for (const l of lands) land.append(el('path', { d: l.d, class: l.home ? 'on' : '' }));
      detailSvg.append(land);
      const st = el('g');
      for (const [o, a, n] of g.stars) {
        const xy = p([o, a]);
        if (!xy) continue;
        const s = el('path', { class: 'star', d: starD(7), transform: `translate(${xy[0].toFixed(1)} ${xy[1].toFixed(1)})` });
        s.dataset.n = n;
        st.append(s);
      }
      detailSvg.append(st);
      bindStars(detailSvg);
    }

    // Fly the world map's viewBox from one box to another.
    const fly = (from: number[], to: number[], ms = 650) => new Promise<void>((done) => {
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / ms), e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        worldSvg.setAttribute('viewBox', from.map((v, i) => v + (to[i] - v) * e).join(' '));
        k < 1 ? requestAnimationFrame(tick) : done();
      };
      requestAnimationFrame(tick);
    });
    // The world-map box (in the current projection) that a country's frame covers, at the map's aspect ratio.
    const flyBox = (box: number[]) => {
      const [x0, y0, x1, y1] = box;
      const pts = [[x0, y0], [x1, y0], [x1, y1], [x0, y1], [(x0 + x1) / 2, (y0 + y1) / 2]].map((q) => wp(q as [number, number])).filter(Boolean) as [number, number][];
      if (pts.length < 5) return null;
      const xs = pts.map((q) => q[0]), ys = pts.map((q) => q[1]);
      const x = Math.min(...xs), y = Math.min(...ys), w = Math.max(...xs) - x, h = Math.max(...ys) - y, r = W / H;
      const ww = Math.max(w, h * r, 8), hh = ww / r;
      return [x + w / 2 - ww / 2, y + h / 2 - hh / 2, ww, hh];
    };

    const cache = new Map<string, Promise<Geo>>();
    const chipOf = (c: string) => chips.find((b) => b.dataset.c === c)!;
    const load = (c: string) => {
      if (!cache.has(c)) cache.set(c, fetch(`/geo/${chipOf(c).dataset.slug}.json`).then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); }));
      return cache.get(c)!;
    };
    chips.forEach((b) => b.addEventListener('pointerenter', () => load(b.dataset.c!).catch(() => {}), { once: true }));

    let current: string | null = null;
    async function open(c: string) {
      if (c === current) return;
      const first = !current;
      current = c;
      chips.forEach((b) => b.classList.toggle('on', b.dataset.c === c));
      picker.open = false; pickLabel.textContent = chipOf(c).firstChild!.textContent!;
      hideTip();
      const data = load(c);
      if (first) {
        proj.hidden = true;
        const box: number[] = JSON.parse(chipOf(c).dataset.box!);
        await worldData;
        if (projId === 'ortho') await turnTo((box[0] + box[2]) / 2, (box[1] + box[3]) / 2);
        const to = flyBox(box);
        if (to && current === c) { worldSvg.classList.add('flying'); await fly(full, to); }
      }
      loading.hidden = false;
      let g: Geo, w: World;
      try { [g, w] = await Promise.all([data, worldData]); } catch {
        loading.textContent = 'Could not load this map. Try again.';
        current = null;
        return;
      } finally { if (current === c) loading.hidden = true; }
      if (current !== c) return;
      draw(g, w);
      worldSvg.classList.add('gone');
      detailSvg.classList.add('show');
      back.hidden = false; hint.hidden = true; here.hidden = false;
      here.textContent = `${c === 'United States of America' ? 'USA' : c} · ${g.stars.length} favourite spots`;
      fillStrip(c);
    }
    function close() {
      if (!current) return;
      current = null;
      detailSvg.classList.remove('show');
      worldSvg.classList.remove('gone');
      proj.hidden = false; strip.hidden = true;
      chips.forEach((b) => b.classList.remove('on'));
      pickLabel.textContent = 'Pick a country';
      back.hidden = true; hint.hidden = false; here.hidden = true;
      hideTip();
      const from = worldSvg.getAttribute('viewBox')!.split(' ').map(Number);
      fly(from, full, 500).then(() => worldSvg.classList.remove('flying'));
    }

    // That country's trip photos, under the map.
    function fillStrip(c: string) {
      const list = albums[c] ?? [];
      strip.replaceChildren();
      strip.hidden = list.length === 0;
      for (const a of list) {
        for (const ph of a.pics) {
          const b = document.createElement('button');
          b.className = 'photo';
          b.dataset.src = `/travels/full/${ph.f}.jpg`;
          b.dataset.caption = [ph.caption, `${a.name} ${a.year ?? ''}`.trim()].filter(Boolean).join(' · ');
          const img = document.createElement('img');
          img.src = `/travels/thumb/${ph.f}.jpg`; img.alt = ph.caption || a.name; img.loading = 'lazy';
          b.append(img);
          strip.append(b);
        }
      }
    }

    back.addEventListener('click', close);
    chips.forEach((b) => b.addEventListener('click', () => (b.dataset.c === current ? close() : open(b.dataset.c!))));
    countryEls.forEach((p, c) => {
      if (!canZoom.has(c)) return;
      p.addEventListener('pointerenter', () => load(c).catch(() => {}), { once: true });
      p.addEventListener('click', () => open(c));
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && current && !document.querySelector('dialog[open]')) close(); });

    // Name tooltip on stars.
    const showTip = (s: Element) => {
      const r = s.getBoundingClientRect(), m = stage.getBoundingClientRect();
      tip.textContent = (s as HTMLElement).dataset.n!;
      tip.hidden = false;
      tip.style.left = `${r.left + r.width / 2 - m.left}px`;
      tip.style.top = `${r.top - m.top}px`;
    };
    function hideTip() { tip.hidden = true; }
    function bindStars(root: Element) {
      root.querySelectorAll('.star').forEach((s) => {
        s.addEventListener('pointerenter', () => showTip(s));
        s.addEventListener('pointerleave', hideTip);
        s.addEventListener('click', (e) => { e.stopPropagation(); showTip(s); });
      });
    }
    bindStars(worldSvg);
  </script>

  <script>
    const pins = document.querySelectorAll<SVGGElement>('.pin');
    const light = (i: string | undefined, on: boolean) =>
      pins.forEach((p) => p.classList.toggle('hot', on && p.dataset.i === i));
    document.querySelectorAll<HTMLElement>('.place').forEach((card) => {
      card.addEventListener('mouseenter', () => light(card.dataset.i, true));
      card.addEventListener('mouseleave', () => light(card.dataset.i, false));
      card.addEventListener('click', () => {
        light(card.dataset.i, true);
        document.querySelector('.map')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  </script>
</Base>

<style>
  .counts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 28px; }
  .count { border-top: 1.5px solid var(--ink); padding-top: 14px; }
  .n { font-family: var(--font-display); font-size: clamp(44px, 6vw, 72px); line-height: 1; }
  .t { color: var(--ink-mute); font-size: 14.5px; margin-top: 6px; }
  @media (max-width: 640px) { .counts { grid-template-columns: 1fr 1fr; } }

  .legend { display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 14px; font-size: 14.5px; color: var(--ink-soft); }
  .legend span, .k { display: inline-flex; align-items: center; gap: 8px; }
  .sw { width: 14px; height: 10px; border-radius: 3px; display: inline-block; }
  .sw.visited { background: linear-gradient(90deg, #b8daa4 50%, #f3e0bb 50%); box-shadow: inset 0 0 0 1px rgba(60, 60, 50, 0.35); }
  .sw.faded { background: color-mix(in srgb, #d4e7b2 40%, #faf9f5); box-shadow: inset 0 0 0 1px var(--line); }
  .biome-key { display: flex; flex-wrap: wrap; gap: 4px 14px; padding: 10px 4px 0; font-size: 12.5px; color: var(--ink-mute); }
  .biome-key span { display: inline-flex; align-items: center; gap: 6px; }
  .biome-key i { width: 11px; height: 11px; border-radius: 3px; box-shadow: inset 0 0 0 1px var(--line); }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .dot.lived, .band.lived { background: var(--rose); }
  .dot.upcoming { background: var(--violet); }
  .dot.science, .band.science { background: var(--cyan); }
  .dot.travel, .band.travel { background: var(--amber); }

  .map { position: relative; padding: 12px; overflow: hidden; }
  .map-bar { display: flex; align-items: center; gap: 12px; min-height: 34px; padding: 2px 4px 10px; font-size: 14px; color: var(--ink-mute); }
  .back { font: inherit; font-weight: 600; color: var(--ink); background: var(--bg-soft); border: 1px solid var(--line); border-radius: 999px; padding: 5px 12px; cursor: pointer; }
  .back:hover { border-color: var(--accent); }
  .here { color: var(--ink); font-weight: 600; }
  .stage { position: relative; }
  .map svg { display: block; width: 100%; height: auto; }

  /* pastel map palette */
  .map {
    --sea: #d4e6f3; --grat: rgba(70, 110, 150, 0.14); --landbase: #e3e6c6; --veil: rgba(250, 249, 245, 0.62);
    --border: rgba(255, 255, 255, 0.9); --border-on: rgba(60, 60, 50, 0.45);
    --desert: #f3e0bb; --dry: #ebe4b8; --grass: #d4e7b2; --forest: #b8daa4; --jungle: #9fcd98; --cold: #dbe6e5; --ice: #f8fafc;
  }
  :global([data-theme='dark']) .map {
    --sea: #1d2c3b; --grat: rgba(150, 190, 230, 0.10); --landbase: #4a5240; --veil: rgba(22, 22, 26, 0.55);
    --border: rgba(20, 20, 24, 0.9); --border-on: rgba(235, 235, 220, 0.5);
    --desert: #7a6a50; --dry: #6c6a4a; --grass: #56704a; --forest: #47694a; --jungle: #3b6142; --cold: #5a6669; --ice: #7d848d;
  }
  .map :global(.sea) { fill: var(--sea); }
  .map :global(.grat) { fill: none; stroke: var(--grat); stroke-width: 0.6; vector-effect: non-scaling-stroke; }
  .map :global(.landbase) { fill: var(--landbase); }
  .map :global(.biomes .desert) { fill: var(--desert); }
  .map :global(.biomes .dry) { fill: var(--dry); }
  .map :global(.biomes .grass) { fill: var(--grass); }
  .map :global(.biomes .forest) { fill: var(--forest); }
  .map :global(.biomes .jungle) { fill: var(--jungle); }
  .map :global(.biomes .cold) { fill: var(--cold); }
