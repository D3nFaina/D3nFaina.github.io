---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { experience, education, service } from '../data/life';
const blocks = [
  { title: 'Positions', items: experience },
  { title: 'Education', items: education },
];
---
<Base title="CV" description="Curriculum vitae.">
  <header class="container page-head head">
    <div>
      <span class="eyebrow">Curriculum vitae</span>
      <h1>CV</h1>
      <p>The short version. The full CV, with grants, teaching and supervision, is one click away.</p>
    </div>
    <a class="btn primary" href={profile.cvPdf} download><Icon name="download" size={16} /> Download PDF</a>
  </header>
  <div class="container cols">
    {blocks.map((b) => (
      <section class="reveal">
        <h2>{b.title}</h2>
        <ol class="tl">
          {b.items.map((it) => (
            <li>
              <div class="when">{it.when}</div>
              <div class="what">{it.role}</div>
              <div class="org">{it.org}</div>
              <div class="det">{it.detail}</div>
            </li>
          ))}
        </ol>
      </section>
    ))}
    <section class="reveal wide card">
      <h2>Collaborations & service</h2>
      <ul class="svc">{service.map((s) => <li>{s}</li>)}</ul>
    </section>
  </div>
</Base>
<style>
  .head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .cols h2 { font-size: 28px; margin-bottom: 22px; }
  .tl { list-style: none; margin: 0; padding: 0 0 0 22px; border-left: 1.5px solid var(--line); display: grid; gap: 26px; }
  .tl li { position: relative; }
  .tl li::before { content: ''; position: absolute; left: -29px; top: 6px; width: 11px; height: 11px; border-radius: 50%; background: var(--bg); border: 2.5px solid var(--accent); }
  .when { font-size: 13px; font-weight: 650; color: var(--accent); letter-spacing: .04em; }
  .what { font-weight: 650; font-size: 18px; margin-top: 2px; }
  .org { color: var(--ink-soft); }
  .det { color: var(--ink-mute); font-size: 14.5px; }
  .wide { grid-column: 1 / -1; padding: 30px; }
  .svc { margin: 0; padding-left: 20px; display: grid; gap: 8px; color: var(--ink-soft); }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr; gap: 40px; } }
</style>
