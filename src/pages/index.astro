---
import Base from '../layouts/Base.astro';
import GardenScene from '../components/GardenScene.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PubItem from '../components/PubItem.astro';
import { profile, stats, news } from '../data/profile';
import { projects } from '../data/research';
import { publications } from '../data/publications';

const featured = projects.filter((p) => p.featured);
const selected = publications.filter((p) => p.first && !p.status).slice(0, 4);
const initials = profile.name.split(' ').map((w) => w[0]).join('');
---
<Base>
  <section class="hero">
    <GardenScene />
    <div class="shade" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="who">
        {profile.photo
          ? <img class="avatar" src={profile.photo} alt={profile.name} width="88" height="88" />
          : <div class="avatar ph" aria-hidden="true">{initials}</div>}
        <div>
          <h1 class="name">{profile.name}</h1>
          <span class="role">{profile.role}</span>
        </div>
      </div>
      <p class="pitch">{profile.pitch}</p>
      <p class="aff"><Icon name="pin" size={16} /> {profile.affiliation}</p>
      <div class="ctas">
        <a class="btn primary" href="/research">Explore my research <Icon name="arrow" size={16} /></a>
        <a class="btn" href={profile.cvPdf}><Icon name="download" size={16} /> CV</a>
      </div>
      <div class="socials">
        {profile.links.github && <a href={profile.links.github}><Icon name="github" /> GitHub</a>}
        {profile.links.orcid && <a href={profile.links.orcid}><Icon name="orcid" /> ORCID</a>}
        {profile.links.scholar && <a href={profile.links.scholar}><Icon name="scholar" /> Scholar</a>}
        <a href={`mailto:${profile.email}`}><Icon name="mail" /> Email</a>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="stats card reveal">
      {stats.map((s) => (
        <div class="stat"><div class="v">{s.value}</div><div class="l">{s.label}</div></div>
      ))}
    </div>
  </section>

  <section class="section container about">
    <div class="reveal">
      <span class="eyebrow">About</span>
      <h2>Making matter's fastest, smallest motions visible.</h2>
    </div>
    <div class="reveal">
      {profile.bio.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section container">
    <div class="section-title">
      <div><span class="eyebrow">Research</span><h2>Selected projects</h2></div>
      <a class="more" href="/research">All projects <Icon name="arrow" size={15} /></a>
    </div>
    <div class="grid3">
      {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>

  <section class="section container split">
    <div>
      <div class="section-title">
        <div><span class="eyebrow">Publications</span><h2>First-author highlights</h2></div>
        <a class="more" href="/publications">All {publications.length} <Icon name="arrow" size={15} /></a>
      </div>
      <div class="reveal">{selected.map((p) => <PubItem pub={p} compact />)}</div>
    </div>
    <aside class="news card reveal">
      <span class="eyebrow">News</span>
      <ul>
        {news.map((n) => <li><span class="d">{n.date}</span><span>{n.text}</span></li>)}
      </ul>
    </aside>
  </section>
</Base>

<style>
  .hero {
    position: relative; overflow: hidden; margin-top: -65px; padding: 200px 0 150px;
    --hero-bg: #3b3c42;
    --ink: #f6f5f8; --ink-soft: rgba(246, 245, 248, 0.84); --ink-mute: rgba(246, 245, 248, 0.62);
    --accent: #ffffff; --line: rgba(255, 255, 255, 0.22); --bg-elev: rgba(255, 255, 255, 0.06);
    color: var(--ink); background: var(--hero-bg);
  }
  /* Darken behind the text on the left, then melt the gray into the page below. */
  .shade { position: absolute; inset: 0; pointer-events: none; background:
      linear-gradient(180deg, transparent 0%, transparent 74%, var(--page-bg) 100%),
      linear-gradient(90deg, var(--hero-bg) 0%, color-mix(in srgb, var(--hero-bg) 60%, transparent) 34%, transparent 52%); }
  .hero-inner { position: relative; }
  .who { display: flex; align-items: center; gap: 18px; }
  .avatar {
    width: 88px; height: 88px; border-radius: 50%; object-fit: cover; flex: none;
    border: 3px solid #fff; box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
  }
  .ph { display: grid; place-items: center; font-family: 'Caveat', cursive; font-size: 40px; color: var(--hero-bg); background: #fff; }
  .name { font-family: 'Caveat', cursive; font-weight: 600; font-size: 40px; line-height: 1; letter-spacing: 0; font-variation-settings: normal; }
  .role { display: block; margin-top: 6px; font-size: 12.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); }
  .pitch {
    font-family: var(--font-display); font-weight: 400; letter-spacing: -0.015em;
    font-size: clamp(26px, 3vw, 38px); line-height: 1.18; max-width: 520px; margin: 34px 0 0; color: var(--ink);
  }
  .aff { display: flex; align-items: center; gap: 8px; color: var(--ink-mute); font-size: 15px; margin: 20px 0 0; }
  .ctas { display: flex; gap: 10px; margin-top: 30px; flex-wrap: wrap; }
  .hero .btn.primary { background: #fff; color: #1d1d22; border-color: #fff; }
  .hero .btn.primary:hover { background: #e8e8ee; border-color: #e8e8ee; color: #1d1d22; }
  .hero .btn { backdrop-filter: blur(8px); }
  .socials { display: flex; gap: 18px; margin-top: 26px; flex-wrap: wrap; }
  .socials a { display: inline-flex; align-items: center; gap: 7px; color: var(--ink-soft); font-size: 14.5px; font-weight: 500; transition: color .2s; }
  .socials a:hover { color: #fff; }
  @media (max-width: 860px) {
    .hero { padding: 120px 0 300px; }
    .shade { background:
      linear-gradient(180deg, transparent 0%, transparent 80%, var(--page-bg) 100%),
      linear-gradient(180deg, var(--hero-bg) 0%, color-mix(in srgb, var(--hero-bg) 80%, transparent) 50%, transparent 65%); }
    .avatar, .ph { width: 72px; height: 72px; }
    .name { font-size: 34px; }
  }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); padding: 8px; }
  .stat { padding: 22px 20px; border-right: 1px solid var(--line); }
  .stat:last-child { border-right: 0; }
  .v { font-family: var(--font-display); font-size: clamp(30px, 3.6vw, 42px); line-height: 1; }
  .l { color: var(--ink-mute); font-size: 14px; margin-top: 8px; }
  @media (max-width: 760px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .stat:nth-child(2) { border-right: 0; }
    .stat:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }

  .about { display: grid; grid-template-columns: 1fr 1.3fr; gap: 48px; padding-top: 88px; }
  .about h2 { font-size: clamp(30px, 3.6vw, 44px); margin-top: 12px; }
  .about p { margin: 0 0 16px; color: var(--ink-soft); font-size: 18px; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; gap: 16px; padding-top: 56px; } }

  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 960px) { .grid3 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid3 { grid-template-columns: 1fr; } }

  .split { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: start; }
  @media (max-width: 960px) { .split { grid-template-columns: 1fr; } }
  .news { padding: 26px; position: sticky; top: 88px; }
  .news ul { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 16px; }
  .news li { display: grid; grid-template-columns: 48px 1fr; gap: 12px; font-size: 15px; color: var(--ink-soft); line-height: 1.5; }
  .news .d { font-weight: 650; color: var(--ink); font-size: 13.5px; padding-top: 2px; }
</style>
