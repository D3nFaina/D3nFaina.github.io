---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PubItem from '../components/PubItem.astro';
import SodaStage from '../components/SodaStage.astro';
import { profile, stats, news } from '../data/profile';
import { projects } from '../data/research';
import { publications } from '../data/publications';
import { readFileSync } from 'node:fs';

const featured = projects.filter((p) => p.featured);
const selected = publications.filter((p) => p.first && !p.status).slice(0, 4);
// Random Japan background: picked at build time by scripts/fetch-japan.mjs.
// Swap in your own photos later by dropping them in public/japan/ with a manifest.json.
let japan: { src: string; title: string; artist: string; license: string; page: string }[] = [];
try { japan = JSON.parse(readFileSync('public/japan/manifest.json', 'utf8')); } catch {}
const initials = profile.name.split(' ').map((w) => w[0]).join('');
---
<Base>
  <script is:inline slot="head">
    try { if (localStorage.getItem('cringe') === 'on') document.documentElement.dataset.cringe = 'on'; } catch (e) {}
  </script>
  <label class="cringe">
    <input type="checkbox" role="switch" aria-label="Feeling Cringe?" />
    <span class="track" aria-hidden="true"><span class="knob"></span></span>
    <span class="txt">Feeling Cringe?</span>
  </label>
  <SodaStage />
  <section class="hero" data-bg={JSON.stringify(japan)}>
    <div class="bg" aria-hidden="true"></div>
    <div class="shade" aria-hidden="true"></div>
    <a class="credit" target="_blank" rel="noopener"></a>
    <div class="container hero-inner">
      <div class="who">
        {profile.photo
          ? <img class="avatar" src={profile.photo} alt={profile.name} width="132" height="132" />
          : <div class="avatar ph" aria-hidden="true">{initials}</div>}
        <div>
          <h1 class="name">{profile.name.split(' ').map((w) => <span>{w}</span>)}</h1>
          <span class="role">{profile.role}</span>
        </div>
      </div>
      <p class="pitch">{profile.pitch}</p>
      <p class="aff"><Icon name="pin" size={16} /> {profile.affiliation}</p>
      <div class="ctas">
        <a class="btn primary" href="/research">Explore my research <Icon name="arrow" size={16} /></a>
        <a class="btn" href={profile.cvPdf}><Icon name="download" size={16} /> CV</a>
      </div>
      <div class="socials">
        {profile.links.github && <a href={profile.links.github}><Icon name="github" /> GitHub</a>}
        {profile.links.orcid && <a href={profile.links.orcid}><Icon name="orcid" /> ORCID</a>}
        {profile.links.scholar && <a href={profile.links.scholar}><Icon name="scholar" /> Scholar</a>}
        <a href={`mailto:${profile.email}`}><Icon name="mail" /> Email</a>
        {profile.links.cringedin && <a href={profile.links.cringedin} target="_blank" rel="noopener"><Icon name="cringedin" /> CringedIn</a>}
      </div>
    </div>
  </section>

  <section class="container stats-wrap">
    <div class="stats card reveal">
      {stats.map((s) => (
        <div class="stat"><div class="v">{s.value}</div><div class="l">{s.label}</div>{s.note && <div class="note">{s.note}</div>}</div>
      ))}
    </div>
  </section>

  <section class="section container about">
    <div class="reveal">
      <span class="eyebrow">About</span>
      <h2>Making matter's fastest, smallest motions visible.</h2>
    </div>
    <div class="reveal">
      {profile.bio.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section container">
    <div class="section-title">
      <div><span class="eyebrow">Research</span><h2>Selected projects</h2></div>
      <a class="more" href="/research">All projects <Icon name="arrow" size={15} /></a>
    </div>
    <div class="grid3">
      {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>

  <section class="section container split">
    <div>
      <div class="section-title">
        <div><span class="eyebrow">Publications</span><h2>First-author highlights</h2></div>
        <a class="more" href="/publications">All {publications.length} <Icon name="arrow" size={15} /></a>
      </div>
      <div class="reveal">{selected.map((p) => <PubItem pub={p} compact />)}</div>
    </div>
    <aside class="news card reveal">
      <span class="eyebrow">News</span>
      <ul>
        {news.map((n) => <li><span class="d">{n.date}</span><span>{n.text}</span></li>)}
      </ul>
    </aside>
  </section>
</Base>

<script>
  const sw = document.querySelector<HTMLInputElement>('.cringe input')!;
  sw.checked = document.documentElement.dataset.cringe === 'on';
  sw.addEventListener('change', () => {
    const on = sw.checked;
    if (on) document.documentElement.dataset.cringe = 'on';
    else delete document.documentElement.dataset.cringe;
    try { localStorage.setItem('cringe', on ? 'on' : 'off'); } catch {}
    window.scrollTo(0, 0);
    dispatchEvent(new Event('cringechange'));
  });

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const list = JSON.parse(hero.dataset.bg || '[]');
  if (list.length) {
    const pick = list[Math.floor(Math.random() * list.length)];
    const img = new Image();
    img.onload = () => {
      const bg = hero.querySelector<HTMLElement>('.bg')!;
      bg.style.backgroundImage = `url("${img.src}")`;
      bg.classList.add('on');
    };
    img.src = pick.src;
    const credit = hero.querySelector<HTMLAnchorElement>('.credit')!;
    credit.href = pick.page;
    credit.textContent = `${pick.title} · ${pick.artist} · ${pick.license}`;
  }
</script>

<style>
  :global(html[data-cringe='on']) .hero, :global(html[data-cringe='on']) .stats-wrap { display: none; }
  .cringe {
    position: absolute; top: 80px; right: 18px; z-index: 30; display: inline-flex; align-items: center; gap: 9px;
    padding: 7px 13px 7px 8px; border-radius: 999px; cursor: pointer; user-select: none;
    background: rgba(20, 20, 24, 0.55); color: #fff; border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    font-family: 'Caveat', cursive; font-weight: 600; font-size: 21px; line-height: 1;
  }
  .cringe input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .track { position: relative; width: 36px; height: 20px; border-radius: 999px; background: rgba(255, 255, 255, 0.3); transition: background 0.2s; flex: none; }
  .knob { position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform 0.2s; }
  .cringe input:checked + .track { background: #8c1d2f; }
  .cringe input:checked + .track .knob { transform: translateX(16px); }
  .cringe input:focus-visible + .track { outline: 2px solid #fff; outline-offset: 2px; }
  .hero {
    position: relative; overflow: hidden; margin-top: -65px; padding: 190px 0 130px;
    --hero-bg: #3b3c42;
    --ink: #f6f5f8; --ink-soft: rgba(246, 245, 248, 0.84); --ink-mute: rgba(246, 245, 248, 0.62);
    --accent: #ffffff; --line: rgba(255, 255, 255, 0.22); --bg-elev: rgba(255, 255, 255, 0.06);
    color: var(--ink); background: var(--hero-bg);
  }
  /* Darken behind the text on the left, then melt the gray into the page below. */
  .bg { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 0; transform: scale(1.05); transition: opacity 1.4s ease, transform 8s ease-out; }
  .bg.on { opacity: 1; transform: scale(1); }
  .shade { position: absolute; inset: 0; pointer-events: none; background:
      linear-gradient(90deg, rgba(40, 41, 46, 0.82) 0%, rgba(40, 41, 46, 0.55) 45%, rgba(40, 41, 46, 0.1) 100%),
      linear-gradient(180deg, rgba(40, 41, 46, 0.45) 0%, transparent 22%, transparent 62%, var(--page-bg) 100%); }
  .credit { position: absolute; right: 16px; bottom: 14px; z-index: 2; font-size: 11.5px; color: rgba(255, 255, 255, 0.6); max-width: 60%; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6); }
  .credit:hover { color: #fff; }
  .hero-inner { position: relative; }
  .who { display: flex; align-items: center; gap: 22px; }
  .avatar {
    width: 132px; height: 132px; border-radius: 50%; object-fit: cover; flex: none;
    border: 3px solid #fff; box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
  }
  .ph { display: grid; place-items: center; font-family: 'Caveat', cursive; font-size: 52px; color: var(--hero-bg); background: #fff; }
  .name { font-family: 'Caveat', cursive; font-weight: 600; font-size: 46px; line-height: 0.95; letter-spacing: 0; font-variation-settings: normal; }
  .name span { display: block; }
  .role { display: block; margin-top: 6px; font-size: 12.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); }
  .pitch {
    font-family: var(--font-display); font-weight: 400; letter-spacing: -0.015em;
    font-size: clamp(26px, 3vw, 38px); line-height: 1.18; max-width: 520px; margin: 34px 0 0; color: var(--ink);
  }
  .aff { display: flex; align-items: center; gap: 8px; color: var(--ink-mute); font-size: 15px; margin: 20px 0 0; }
  .ctas { display: flex; gap: 10px; margin-top: 30px; flex-wrap: wrap; }
  .hero .btn.primary { background: #fff; color: #1d1d22; border-color: #fff; }
  .hero .btn.primary:hover { background: #e8e8ee; border-color: #e8e8ee; color: #1d1d22; }
  .hero .btn { backdrop-filter: blur(8px); }
  .socials { display: flex; gap: 18px; margin-top: 26px; flex-wrap: wrap; }
  .socials a { display: inline-flex; align-items: center; gap: 7px; color: var(--ink-soft); font-size: 14.5px; font-weight: 500; transition: color .2s; }
  .socials a:hover { color: #fff; }
  @media (max-width: 860px) {
    .hero { padding: 120px 0 110px; }
    .shade { background:
      linear-gradient(180deg, rgba(40, 41, 46, 0.7) 0%, rgba(40, 41, 46, 0.55) 55%, var(--page-bg) 100%); }
    .credit { display: none; }
    .avatar, .ph { width: 104px; height: 104px; }
    .name { font-size: 40px; }
  }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); padding: 8px; }
  .stat { padding: 22px 20px; border-right: 1px solid var(--line); }
  .stat:last-child { border-right: 0; }
  .v { font-family: var(--font-display); font-size: clamp(30px, 3.6vw, 42px); line-height: 1; }
  .l { color: var(--ink-mute); font-size: 14px; margin-top: 8px; }
  .note { color: var(--ink-mute); font-size: 11.5px; font-style: italic; margin-top: 4px; opacity: 0.8; }
  @media (max-width: 760px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .stat:nth-child(2) { border-right: 0; }
    .stat:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }

  .about { display: grid; grid-template-columns: 1fr 1.3fr; gap: 48px; padding-top: 88px; }
  .about h2 { font-size: clamp(30px, 3.6vw, 44px); margin-top: 12px; }
  .about p { margin: 0 0 16px; color: var(--ink-soft); font-size: 18px; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; gap: 16px; padding-top: 56px; } }

  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 960px) { .grid3 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid3 { grid-template-columns: 1fr; } }

  .split { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: start; }
  @media (max-width: 960px) { .split { grid-template-columns: 1fr; } }
  .news { padding: 26px; position: sticky; top: 88px; }
  .news ul { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 16px; }
  .news li { display: grid; grid-template-columns: 48px 1fr; gap: 12px; font-size: 15px; color: var(--ink-soft); line-height: 1.5; }
  .news .d { font-weight: 650; color: var(--ink); font-size: 13.5px; padding-top: 2px; }
</style>
